<Window x:Class="SuperCV.TextBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SuperCV"
        Title="Dialog"
        Width="380"
        Height="205"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Border CornerRadius="20"
                Background="{DynamicResource Brush.Surface.Window}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Color="{DynamicResource Color.Shadow.Surface}"
                                  Opacity="0.5"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="20"
                Background="{DynamicResource Brush.Surface.Window}">
            <Grid Margin="10"
                  RenderOptions.ClearTypeHint="Enabled">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Grid Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <local:CrispWindowHeaderLogo/>
                    <Label Content="{Binding TitleText}"
                           Style="{StaticResource WindowHeaderTitleStyle}"/>
                </Grid>

                <local:CrispShadowBorder Grid.Row="1"
                        Margin="0,5"
                        CornerRadius="10"
                        Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Control}"
                        BorderThickness="1">
                    <local:CrispShadowBorder.ShadowEffect>
                        <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="0"
                                          Color="{DynamicResource Color.Shadow.Surface}"
                                          Opacity="{Binding InputShadowOpacity}"/>
                    </local:CrispShadowBorder.ShadowEffect>
                    <Grid RenderOptions.ClearTypeHint="Enabled">
                        <TextBox x:Name="InputTextBox"
                                 MaxLength="30"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8"
                                 FontSize="16"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 SelectionBrush="{DynamicResource Brush.Text.Selection}"
                                 CaretBrush="{DynamicResource Brush.Text.Caret}"
                                 TextChanged="InputTextBox_TextChanged"
                                 AutomationProperties.Name="{Binding Placeholder}"/>
                        <TextBlock IsHitTestVisible="False"
                                   Text="{Binding Placeholder}"
                                   Padding="10,8"
                                   FontSize="16"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </local:CrispShadowBorder>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="确定"
                            Margin="0,5,5,0"
                            FontSize="18"
                            FontWeight="DemiBold"
                            Style="{StaticResource decideButtonStyle}"
                            Background="{DynamicResource Brush.Control.FillMuted}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            IsDefault="True"
                            Click="ConfirmButton_Click"/>
                    <Button Grid.Column="1"
                            Content="取消"
                            Margin="5,5,0,0"
                            FontSize="18"
                            FontWeight="DemiBold"
                            Style="{StaticResource decideButtonStyle}"
                            Background="{DynamicResource Brush.Control.FillMuted}"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
