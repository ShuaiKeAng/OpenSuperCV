<UserControl x:Class="SuperCV.TutorialCvPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SuperCV"
             Width="310"
             Height="140"
             IsHitTestVisible="False"
             Focusable="False">
    <UserControl.Resources>
        <DropShadowEffect x:Key="TutorialCvNormalShadow"
                          BlurRadius="10"
                          ShadowDepth="0"
                          Color="{DynamicResource Color.Shadow.Surface}"
                          RenderingBias="Performance"
                          Opacity="0.7"/>
    </UserControl.Resources>
    <Grid Margin="10" Width="280" Height="110">
        <Border CornerRadius="20"
                Background="{DynamicResource Brush.Surface.Window}"
                Effect="{StaticResource TutorialCvNormalShadow}"/>
        <Border CornerRadius="20"
                Background="{DynamicResource Brush.Surface.Window}"
                RenderOptions.ClearTypeHint="Enabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Width="35" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Margin="5,5,0,0"
                            Style="{StaticResource baseButtonStyle}"
                            Background="{DynamicResource Brush.Surface.Raised}">
                        <Viewbox Width="30" Height="30">
                            <Label Content="AI" FontSize="24" FontFamily="Arial" FontWeight="SemiBold">
                                <Label.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource Color.AiAccent.Start}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource Color.AiAccent.Middle}" Offset="0.5"/>
                                        <GradientStop Color="{DynamicResource Color.AiAccent.End}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Label.Foreground>
                            </Label>
                        </Viewbox>
                    </Button>
                    <Button Grid.Row="1"
                            Margin="5,5,0,5"
                            Style="{StaticResource baseButtonStyle}"
                            Background="{DynamicResource Brush.Surface.Raised}">
                        <Viewbox Width="17" Height="17"><StaticResource ResourceKey="Menu"/></Viewbox>
                    </Button>
                    <Button Grid.Row="2"
                            Margin="5,0,0,5"
                            Style="{StaticResource baseButtonStyle}"
                            Background="{DynamicResource Brush.Surface.Raised}">
                        <Viewbox Width="19" Height="19"><StaticResource ResourceKey="Delete"/></Viewbox>
                    </Button>
                </Grid>

                <Grid Grid.Column="1" Margin="5">
                    <Border CornerRadius="15"
                            Background="{DynamicResource Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Brush.Border.Soft}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition Height="17"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2"
                                    Width="5"
                                    Height="32"
                                    Margin="3"
                                    HorizontalAlignment="Right"
                                    Background="{Binding MarkerBrush, RelativeSource={RelativeSource AncestorType=local:TutorialCvPreview}}"
                                    CornerRadius="2.5"/>
                            <TextBlock Margin="8,4,8,-2"
                                       MaxHeight="80"
                                       Text="{Binding PreviewText, RelativeSource={RelativeSource AncestorType=local:TutorialCvPreview}}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="14"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <Grid Grid.Row="1" Margin="8,1,8,2" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MetricsText, RelativeSource={RelativeSource AncestorType=local:TutorialCvPreview}}" FontSize="10" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="刚刚" FontSize="10" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding IndexText, RelativeSource={RelativeSource AncestorType=local:TutorialCvPreview}}" FontSize="10" FontFamily="Microsoft YaHei UI" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
