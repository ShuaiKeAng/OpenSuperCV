                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="Dot0" Style="{StaticResource TutorialPageIndicatorStyle}" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="第 1 页"/><Button x:Name="Dot1" Style="{StaticResource TutorialPageIndicatorStyle}" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="第 2 页"/><Button x:Name="Dot2" Style="{StaticResource TutorialPageIndicatorStyle}" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="第 3 页"/><Button x:Name="Dot3" Style="{StaticResource TutorialPageIndicatorStyle}" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="第 4 页"/><Button x:Name="DotSettings" Style="{StaticResource TutorialPageIndicatorStyle}" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="第 5 页：初始设置"/></StackPanel>
                    <Button x:Name="NextButton" Content="{Binding NextNavigationText, ElementName=TutorialWindow}" Style="{StaticResource TutorialPrimaryButtonStyle}" HorizontalAlignment="Right" Click="Next_Click"/>
                </Grid>
            </Grid>
        </local:CrispShadowBorder>
    </Grid>
</Window>
