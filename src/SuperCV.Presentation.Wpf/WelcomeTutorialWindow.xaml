<Window x:Class="SuperCV.WelcomeTutorialWindow"
        x:Name="TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SuperCV"
        Title="SuperCV 欢迎" Width="800" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="TutorialLinkBrush" Color="{DynamicResource Color.AiAccent.Middle}"/>
        <Style x:Key="TutorialNavButtonStyle" TargetType="Button" BasedOn="{StaticResource decideButtonStyle}">
            <Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="96"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Control.FillMuted}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        </Style>
        <Style x:Key="TutorialPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource decideButtonStyle}">
            <Setter Property="Height" Value="38"/><Setter Property="MinWidth" Value="108"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Surface.Raised}"/>
        </Style>
        <Style x:Key="TutorialPageIndicatorStyle" TargetType="Button" BasedOn="{StaticResource PointerOnlyControlStyle}">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="22"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Indicator" Width="18" Height="4" CornerRadius="2" Background="{DynamicResource Brush.Border.Soft}"/></Grid><ControlTemplate.Triggers><Trigger Property="Tag" Value="Selected"><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Brush.Text.Primary}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Brush.Text.Secondary}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ShortcutKeyStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="9,5"/>
        </Style>
        <Style x:Key="AnnotationStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Text.Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.Raised}"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="AnnotationTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="DemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.Surface.Raised}"/>
        </Style>
        <Style x:Key="InteractiveAnnotationStyle" TargetType="Border" BasedOn="{StaticResource AnnotationStyle}">
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="MouseEnter" Handler="CalloutLabel_MouseEnter"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Text.Secondary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TutorialConnectorLineStyle" TargetType="Polyline">
            <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Opacity" Value="0.82"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
        </Style>
        <Style x:Key="TutorialLanguageSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TutorialChineseOnlyTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnglish, Source={x:Static local:LocalizationService.Current}}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TutorialEnglishOnlyTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnglish, Source={x:Static local:LocalizationService.Current}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
    </Window.Resources>

    <Grid Margin="20">
        <local:CrispShadowBorder CornerRadius="20" Background="{DynamicResource Brush.Surface.Window}">
            <local:CrispShadowBorder.ShadowEffect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="{DynamicResource Color.Shadow.Surface}" Opacity="0.5"/></local:CrispShadowBorder.ShadowEffect>
            <Grid Margin="10" RenderOptions.ClearTypeHint="Enabled">
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <local:CrispWindowHeaderLogo/>
                    <Label Content="欢迎" Style="{StaticResource WindowHeaderTitleStyle}"/>
                    <!-- Compact language switch: intentionally not a drop-down so it remains one-click on the welcome home. -->
                    <Border x:Name="LanguageSwitch"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="140,5,0,0"
                            Width="118"
                            Height="30"
                            Padding="2"
                            Background="{DynamicResource Brush.Control.FillMuted}"
                            BorderBrush="{DynamicResource Brush.Border.Soft}"
                            BorderThickness="1"
                            CornerRadius="15"
                            AutomationProperties.Name="显示语言">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="LanguageThumb"
                                    Width="54"
                                    Height="22"
                                    Margin="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Surface.Raised}"
                                    BorderThickness="0"
                                    CornerRadius="11"
                                    IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglish, Source={x:Static local:LocalizationService.Current}}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             To="56"
                                                                             Duration="0:0:0.18"
                                                                             AccelerationRatio="0.25"
                                                                             DecelerationRatio="0.55"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             To="0"
                                                                             Duration="0:0:0.18"
                                                                             AccelerationRatio="0.25"
                                                                             DecelerationRatio="0.55"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=LanguageSwitch}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Control.HoverSubtle}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Button Grid.Column="0" Tag="zh-CN" Content="中文" Click="SelectLanguage_Click" Style="{StaticResource TutorialLanguageSegmentButtonStyle}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" Panel.ZIndex="1" AutomationProperties.Name="切换为中文"/>
                            <Button Grid.Column="1" Tag="en-US" Content="EN" Click="SelectLanguage_Click" Style="{StaticResource TutorialLanguageSegmentButtonStyle}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" Panel.ZIndex="1" AutomationProperties.Name="Switch to English"/>
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource WindowHeaderCloseButtonStyle}" Click="Minimize_Click" ToolTip="最小化" HorizontalAlignment="Right" Margin="4,4,4,4" AutomationProperties.Name="最小化欢迎页"><Path Data="M0,5 L10,5" Width="16" Height="16" Stroke="{DynamicResource Brush.Icon.Primary}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Fill"/></Button>
                </Grid>

                <Grid Grid.Row="1" Margin="14,6,14,0">
                    <!-- 初次设置：所有项均可跳过，未修改时保留当前设置。 -->
                    <Grid x:Name="PageSettings">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="84"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="10,8,10,0">
                                <TextBlock Text="欢迎使用 SuperCV" FontSize="25" FontWeight="DemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock Margin="0,7,0,0" Text="按你的习惯配置常用功能，所有选项都可以稍后在“选项”中调整。" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="5,0,5,5">
                                    <local:CrispShadowBorder CornerRadius="10" Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Soft}" BorderThickness="0" Margin="5,20,5,5">
                                        <local:CrispShadowBorder.ShadowEffect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{DynamicResource Color.Shadow.Surface}" Opacity="0.2"/>
                                        </local:CrispShadowBorder.ShadowEffect>
                                        <Grid Margin="5" Grid.IsSharedSizeScope="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0" RenderOptions.ClearTypeHint="Enabled">
                                                <Grid Height="48" Margin="5,0">
                                                    <Label Content="开机自启" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="登录 Windows 后自动启动 SuperCV" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <local:MySwitch IsOn="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8" SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                                </Grid>
   <Grid Height="48" Margin="5,0">
                                                    <Label Content="关闭应用直接退出" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="关闭窗口后直接退出，而不是留在后台" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <local:MySwitch IsOn="{Binding ExitOnClose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8" SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                                </Grid>
     <Grid Height="48" Margin="5,0">
                                                    <Label Content="删除确认" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="开启后删除条目会进行二次确认" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <local:MySwitch IsOn="{Binding DeleteConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8" SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                                </Grid>
                                            </StackPanel>
     <StackPanel Grid.Column="2" Margin="8,0,0,0" RenderOptions.ClearTypeHint="Enabled">
                                                <Grid Height="48" Margin="5,0">
                                                    <Label Content="重复复制时清理旧条目" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="重复复制相同内容时，仅保留新复制条目" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <local:MySwitch IsOn="{Binding RemoveOldDuplicateEntriesOnCopy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8" SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                                </Grid>
    <Grid Height="48" Margin="5,0">
                                                    <Label Content="支持图片" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="开启后支持复制图片" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <local:MySwitch IsOn="{Binding EnableImageSupport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8" SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                                </Grid>
        <Grid Height="48" Margin="5,0">
                                                    <Label Content="AI 功能" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="统一控制所有 AI 功能" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <local:MySwitch IsOn="{Binding EnableAiFeatures, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="AI 功能总开关" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8" SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </local:CrispShadowBorder>

                                    <local:CrispShadowBorder CornerRadius="10" Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Soft}" BorderThickness="0" Margin="5,30,5,5" Visibility="{Binding AISettingsVisibility}">
                                        <local:CrispShadowBorder.ShadowEffect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{DynamicResource Color.Shadow.Surface}" Opacity="0.2"/>
                                        </local:CrispShadowBorder.ShadowEffect>
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,8,0" RenderOptions.ClearTypeHint="Enabled">
                                                <Grid Height="48" Margin="5,0,5,27">
                                                    <Label Content="大模型选择" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="统一使用 OpenAI 兼容调用格式" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <ComboBox SelectedValue="{Binding AIModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Style="{StaticResource RoundedComboBoxStyle2}" Height="24" Width="110" HorizontalAlignment="Right" Margin="0,8,5,8" BorderThickness="1" Background="{DynamicResource Brush.Control.FillSubtle}">
                                                        <ComboBoxItem Content="DeepSeek" Tag="{x:Static local:AIProvider.DeepSeek}"/>
                                                        <ComboBoxItem Content="GLM" Tag="{x:Static local:AIProvider.ChatGLM}"/>
                                                        <ComboBoxItem Content="MiniMax" Tag="{x:Static local:AIProvider.Minimax}"/>
                                                        <ComboBoxItem Content="自定义" Tag="{x:Static local:AIProvider.Custom}"/>
                                                    </ComboBox>
                                                </Grid>
   <Grid Height="75" Margin="5,0">
                                                    <Label Content="API Key" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="输入当前模型提供商对应的密钥" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="5,0,0,38" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding AIAPIKeyLinkVisibility}">
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,0,10,38" FontSize="12" Cursor="Hand"
                                                                   Style="{StaticResource TutorialChineseOnlyTextStyle}"
                                                                   local:LocalizationService.SkipLocalization="True">
                                                            <Hyperlink NavigateUri="{Binding AIAPIKeyURL}" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#2563EB" TextDecorations="Underline" Cursor="Hand"><Run Text="获取"/></Hyperlink>
                                                        </TextBlock>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,0,10,38" FontSize="12" Cursor="Hand"
                                                                   Style="{StaticResource TutorialEnglishOnlyTextStyle}"
                                                                   local:LocalizationService.SkipLocalization="True">
                                                            <Hyperlink NavigateUri="{Binding AIAPIKeyURL}" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#2563EB" TextDecorations="Underline" Cursor="Hand"><Run Text="Get"/></Hyperlink>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBox Text="{Binding APIKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Style="{StaticResource WatermarkTextBoxStyle}" Background="{DynamicResource Brush.Control.FillSubtle}" Margin="5"/>
                                                </Grid>
                                            </StackPanel>
    <StackPanel Grid.Column="2" Margin="8,0,0,0" RenderOptions.ClearTypeHint="Enabled">
                                                <Grid Height="75" Margin="5,0">
                                                    <Label Content="API 地址" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="支持 base_url 或完整 chat/completions 地址" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="5,0,0,38" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <TextBox Text="{Binding AIBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Style="{StaticResource WatermarkTextBoxStyle}" Background="{DynamicResource Brush.Control.FillSubtle}" Margin="5"/>
                                                </Grid>
       <Grid Height="75" Margin="5,0">
                                                    <Label Content="模型名称" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                    <Label Content="默认厂商自动切换，自定义可直接输入" VerticalAlignment="Bottom" HorizontalAlignment="Left" Padding="5,0,0,38" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <TextBox Text="{Binding AIModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Style="{StaticResource WatermarkTextBoxStyle}" Background="{DynamicResource Brush.Control.FillSubtle}" Margin="5"/>
                                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,0,10,38" FontSize="12" Cursor="Hand"
                                                                   Style="{StaticResource TutorialChineseOnlyTextStyle}"
                                                                   local:LocalizationService.SkipLocalization="True">
                                                            <Hyperlink Click="DebugHyperlink_Click" Foreground="#2563EB" TextDecorations="Underline" Cursor="Hand"><Run Text="调试"/></Hyperlink>
                                                        </TextBlock>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,0,10,38" FontSize="12" Cursor="Hand"
                                                                   Style="{StaticResource TutorialEnglishOnlyTextStyle}"
                                                                   local:LocalizationService.SkipLocalization="True">
                                                            <Hyperlink Click="DebugHyperlink_Click" Foreground="#2563EB" TextDecorations="Underline" Cursor="Hand"><Run Text="Test"/></Hyperlink>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </local:CrispShadowBorder>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <CheckBox x:Name="UserAgreementCheckBox"
                                  Style="{StaticResource TutorialAgreementCheckBoxStyle}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,-10,-14"
                                  AutomationProperties.Name="阅读并同意用户协议"
                                  AutomationProperties.HelpText="勾选后才能完成初始设置"/>
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,25,-10"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Style="{StaticResource TutorialChineseOnlyTextStyle}"
                                   local:LocalizationService.SkipLocalization="True">
                            <Run Text="我已阅读并同意"/>
                            <Hyperlink Click="OpenUserAgreementLink_Click"
                                       Foreground="#2563EB"
                                       TextDecorations="Underline"
                                       Cursor="Hand">
                                <Run Text="用户协议"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,25,-10"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Style="{StaticResource TutorialEnglishOnlyTextStyle}"
                                   local:LocalizationService.SkipLocalization="True">
                            <Run Text="I have read and agree to "/>
                            <Hyperlink Click="OpenUserAgreementLink_Click"
                                       Foreground="#2563EB"
                                       TextDecorations="Underline"
                                       Cursor="Hand">
                                <Run Text="User Agreement"/>
                            </Hyperlink>
                        </TextBlock>

                    </Grid>

                    <!-- 单击与拖拽：先明确目标输入焦点，再展示两种直接操作。 -->
                    <Grid x:Name="Page0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="6,0,25,0" VerticalAlignment="Center">
                            <TextBlock Text="复制" FontSize="25" FontWeight="DemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Margin="0,10,0,8" Text="在其他软件中复制内容时，SuperCV 会自动监听并收纳到当前工作区。" TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <WrapPanel>
                                <Border Margin="0,0,6,0" Padding="8,4" CornerRadius="7" Background="{DynamicResource Brush.Control.FillMuted}">
                                    <TextBlock Text="图片" FontSize="12" FontWeight="DemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </Border>
                                <Border Margin="0,0,6,0" Padding="8,4" CornerRadius="7" Background="{DynamicResource Brush.Control.FillMuted}">
                                    <TextBlock Text="纯文本" FontSize="12" FontWeight="DemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </Border>
