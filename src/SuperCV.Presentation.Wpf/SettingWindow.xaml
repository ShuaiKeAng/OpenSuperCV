                                            </Viewbox>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </local:CrispShadowBorder>



                            
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                </TabControl>


        </Grid>
    </local:CrispShadowBorder>
</Window>
