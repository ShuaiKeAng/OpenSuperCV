<Window x:Class="SuperCV.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuperCV"
        mc:Ignorable="d"
        Title="SettingWindow"  
        Width="399" Height="540"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SettingChineseOnlyTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnglish, Source={x:Static local:LocalizationService.Current}}" Value="False">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingEnglishOnlyTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnglish, Source={x:Static local:LocalizationService.Current}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <local:CrispShadowBorder CornerRadius="20"
                             Background="{DynamicResource Brush.Surface.Window}"
                             Margin="20">
        <local:CrispShadowBorder.ShadowEffect>
            <DropShadowEffect BlurRadius="30" 
                              ShadowDepth="0" 
                              Color="{DynamicResource Color.Shadow.Surface}"
                              Opacity="0.5"/>
        </local:CrispShadowBorder.ShadowEffect>

        <Grid Margin="10"
              RenderOptions.ClearTypeHint="Enabled"
              TextOptions.TextFormattingMode="Display"
              TextOptions.TextRenderingMode="ClearType"
              TextOptions.TextHintingMode="Fixed">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="45"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Background="#00000000" MouseLeftButtonDown="Grid_MouseLeftButtonDown" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <local:CrispWindowHeaderLogo/>
            <Label Content="选项"
                   Style="{StaticResource WindowHeaderTitleStyle}"/>
            <Button x:Name="ResetButton"
                     Style="{StaticResource WindowHeaderCloseButtonStyle}"
                     Click="ResetButton_Click"
                    ToolTip="重置所有设置"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="重置所有设置"
                    AutomationProperties.HelpText="将常规、快捷键、历史记录和 AI 设置恢复为默认值"
                    Margin="4,4,86,4">
                <!-- 参考 010__arrow_anti-clockwise.svg 的逆时针回转箭头。 -->
                <Path Data="M4,8 A7,7 0 1 1 8,15 M4,8 L1.5,4.5 M4,8 L8,6"
                      Width="18"
                      Height="18"
                      Stroke="{DynamicResource Brush.Icon.Primary}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                       Stretch="Uniform"
                       IsHitTestVisible="False"/>
            </Button>
            <Button Style="{StaticResource WindowHeaderCloseButtonStyle}"
                    Click="Minimize_Click"
                    ToolTip="最小化"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="最小化设置"
                    Margin="4,4,45,4">
                <Path Data="M0,5 L10,5"
                      Width="16"
                      Height="16"
                      Stroke="{DynamicResource Brush.Icon.Primary}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="Fill"
                      IsHitTestVisible="False"/>
            </Button>
            <Button Style="{StaticResource WindowHeaderCloseButtonStyle}"
                    Click="CloseButton_Click"
                    ToolTip="关闭"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="关闭设置"
                    Margin="4">
                <Path Data="M0,0 L10,10 M10,0 L0,10"
                      Width="16"
                      Height="16"
                      Stroke="{DynamicResource Brush.Icon.Primary}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="Fill"
                      IsHitTestVisible="False"/>
            </Button>
            </Grid>
            <!-- 导航栏区域：RadioButton 作为视觉导航 -->
            <local:CrispShadowBorder CornerRadius="10"
                                     Background="{DynamicResource Brush.Surface.Raised}"
                                     Grid.Row="1" Margin="0,5,0,5">
                <local:CrispShadowBorder.ShadowEffect>
                    <DropShadowEffect BlurRadius="10" 
                  ShadowDepth="0" 
                  Color="{DynamicResource Color.Shadow.Surface}"
                  Opacity="0.3"/>
                </local:CrispShadowBorder.ShadowEffect>
                <StackPanel Orientation="Horizontal"
                            RenderOptions.ClearTypeHint="Enabled">
                    <!-- 为每个 RadioButton 设置 GroupName 确保互斥，并绑定选中状态 -->
                    <RadioButton x:Name="RadioGeneral"
                                 Style="{StaticResource CustomRadioButtonStyle}" 
                                 Width="65" Margin="4" 
                                 Content="常规" FontSize="14" 
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 Background="{DynamicResource Brush.Surface.Raised}"
                                 IsChecked="True"
                                 GroupName="SettingTabs"/>
                    <Border Background="{DynamicResource Brush.Separator.Strong}"
                            Margin="0,8,0,8" Width="1"/>

                    <RadioButton x:Name="RadioShortcuts"
                                 Style="{StaticResource CustomRadioButtonStyle}" 
                                 Width="65" Margin="4" 
                                 Content="快捷键" FontSize="14" 
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 Background="{DynamicResource Brush.Surface.Raised}"
                                 GroupName="SettingTabs"/>
                    <Border Background="{DynamicResource Brush.Separator.Strong}"
                            Margin="0,8,0,8" Width="1"/>
                    <RadioButton x:Name="RadioAI"
                                 Style="{StaticResource CustomRadioButtonStyle}"
                                 Width="40" Margin="4"
                                 Content="AI" FontSize="14"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 Background="{DynamicResource Brush.Surface.Raised}"
                                 GroupName="SettingTabs"/>

                    <Border Background="{DynamicResource Brush.Separator.Strong}"
                            Margin="0,8,0,8" Width="1"/>

                    <RadioButton x:Name="RadioHistory"
                                 Style="{StaticResource CustomRadioButtonStyle}" 
                                 Width="70" Margin="4" 
                                 Content="历史记录" FontSize="14" 
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 Background="{DynamicResource Brush.Surface.Raised}"
                                 GroupName="SettingTabs"/>
                    <Border Background="{DynamicResource Brush.Separator.Strong}"
                            Margin="0,8,0,8" Width="1"/>

                    <RadioButton x:Name="RadioAbout" 
                                 Style="{StaticResource CustomRadioButtonStyle}" 
                                 Width="55" Margin="4" 
                                 Content="关于" FontSize="14" 
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 Background="{DynamicResource Brush.Surface.Raised}"
                                 GroupName="SettingTabs"/>
                </StackPanel>
            </local:CrispShadowBorder>

            <!-- 内容区域：使用 TabControl 管理页面，但隐藏标签头 -->

                <!-- 这里放 TabControl，它的 SelectedIndex 与 RadioButton 联动 -->
                <TabControl Grid.Row="2" x:Name="MainTabControl"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectedIndex="0" Padding="0"
                            Margin="-10,0,-10,-10">
                    <TabControl.Clip>
                        <PathGeometry>
                            <PathFigure StartPoint="0,0" IsClosed="True">
                                <LineSegment Point="380,0"/>
                                <LineSegment Point="380,383"/>
                                <ArcSegment Point="380,403"
                                            Size="20,20"
                                            SweepDirection="Clockwise"/>
                                <LineSegment Point="20,403"/>
                                <ArcSegment Point="0,383"
                                            Size="20,20"
                                            SweepDirection="Clockwise"/>
                            </PathFigure>
                        </PathGeometry>
                    </TabControl.Clip>
                    <!-- 默认选中第一页 -->
                    <!-- 隐藏 TabControl 的头部 -->
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- 常规设置页 -->
                    <TabItem Header="常规">


                    <ScrollViewer Padding="0,0,0,5" VerticalScrollBarVisibility="Visible" Margin="0,0,0,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar"
                                   BasedOn="{StaticResource ScrollBarThin}">
                                <Setter Property="Margin" Value="0,0,0,12"/>
                            </Style>
                        </ScrollViewer.Resources>
                        
                            
                        

                       
                        <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                            <local:CrispShadowBorder CornerRadius="10"
                                                     Background="{DynamicResource Brush.Surface.Raised}"
                                                     BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                     BorderThickness="1"
                                                     Margin="5">
                                <local:CrispShadowBorder.ShadowEffect>
                                    <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Color="{DynamicResource Color.Shadow.Surface}"
                                                          Opacity="0.2"/>
                                </local:CrispShadowBorder.ShadowEffect>
                                <StackPanel Orientation="Vertical"
                                            Margin="0,5,0,5"
                                            RenderOptions.ClearTypeHint="Enabled">
                                     <Grid Margin="5,0,5,0">
                                         <Label Content="显示语言"
                                                Padding="5,3,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                FontSize="14"
                                                FontWeight="DemiBold"
                                                Foreground="{DynamicResource Brush.Text.Primary}"/>
                                         <Label Content="选择 SuperCV 的显示语言"
                                                Padding="5,0,0,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                FontSize="12"
                                                Foreground="{DynamicResource Brush.Text.Muted}"/>
                                         <ComboBox SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   SelectedValuePath="Tag"
                                                   Style="{StaticResource RoundedComboBoxStyle2}"
                                                   Height="24"
                                                   Width="86"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,8,5,8"
                                                   BorderThickness="1"
                                                   Background="{DynamicResource Brush.Control.FillSubtle}"
                                                   AutomationProperties.Name="显示语言"
                                                   AutomationProperties.HelpText="选择 SuperCV 的显示语言">
                                             <ComboBoxItem Content="中文" Tag="zh-CN"/>
                                             <ComboBoxItem Content="English" Tag="en-US"/>
                                         </ComboBox>
                                     </Grid>
                                     <Border Margin="10,2" Height="1" Background="{DynamicResource Brush.Separator.Default}"/>
                                     <Grid Margin="5,0,5,0">
                                         <Label Content="开机自启" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="登录 Windows 后自动启动 SuperCV" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <local:MySwitch IsOn="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8" SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                    </Grid>
                                    <Border Margin="10,2"
                                            Height="1"
                                            Background="{DynamicResource Brush.Separator.Default}"/>
                                     <Grid Height="40" Margin="5,0,5,0">
                                         <Label Content="关闭应用直接退出"
                                               Padding="5,3,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               FontSize="14"
                                               FontWeight="DemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <Label Content="开启后关闭应用直接退出，否则保留到后台"
                                               Padding="5,0,0,3"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <local:MySwitch IsOn="{Binding ExitOnClose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="50"
                                                        Margin="0,8,5,8"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="直接关闭应用"
                                                        AutomationProperties.HelpText="关闭时退出应用；关闭此开关时应用会留在系统托盘并继续监听剪贴板"
                                                        CornerRadius="12"
                                                        SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}"
                                                        SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}"
                                                        SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}"
                                                         SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}"
                                                         ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                     </Grid>
                                    <Border Margin="10,2"
                                            Height="1"
                                            Background="{DynamicResource Brush.Separator.Default}"/>
                                    <Grid Height="40" Margin="5,0,5,0">
                                        <Label Content="双击多功能按钮行为"
                                               Padding="5,3,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               FontSize="14"
                                               FontWeight="DemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <Label Content="选择双击主界面左侧按钮时的行为"
                                               Padding="5,0,0,3"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <ComboBox SelectedIndex="{Binding MainWindowDoubleClickActionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource RoundedComboBoxStyle2}"
                                                  Height="24"
                                                  Width="86"
                                                  HorizontalAlignment="Right"
                                                  Margin="0,8,5,8"
                                                  BorderThickness="1"
                                                  Background="{DynamicResource Brush.Control.FillSubtle}"
                                                  AutomationProperties.Name="双击主按钮行为"
                                                  AutomationProperties.HelpText="选择双击左侧 SuperCV 按钮时显示浮窗或最小化到任务栏">
                                            <ComboBoxItem Content="浮窗"/>
                                            <ComboBoxItem Content="最小化"/>
                                         </ComboBox>
                                     </Grid>
                                    <Border Margin="10,2"
                                            Height="1"
                                            Background="{DynamicResource Brush.Separator.Default}"
                                            Visibility="{Binding FloatingWindowAutoCollapseVisibility}"/>
                                    <Grid Height="40"
                                          Margin="5,0,5,0"
                                          Visibility="{Binding FloatingWindowAutoCollapseVisibility}">
                                        <Label Content="无操作自动缩回浮窗"
                                               Padding="5,3,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               FontSize="14"
                                               FontWeight="DemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <Label Content="无鼠标操作达到时长后自动缩回"
                                               Padding="5,0,0,3"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <ComboBox SelectedIndex="{Binding FloatingWindowAutoCollapseDelayIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource RoundedComboBoxStyle2}"
                                                  Height="24"
                                                  Width="86"
                                                  HorizontalAlignment="Right"
                                                  Margin="0,8,5,8"
                                                  BorderThickness="1"
                                                  Background="{DynamicResource Brush.Control.FillSubtle}"
                                                  AutomationProperties.Name="无操作自动缩回浮窗"
                                                  AutomationProperties.HelpText="仅在双击多功能按钮设为浮窗时生效；选择无鼠标操作多久后自动缩回浮窗">
                                            <ComboBoxItem Content="关闭"/>
                                            <ComboBoxItem Content="5秒"/>
                                            <ComboBoxItem Content="10秒"/>
                                            <ComboBoxItem Content="20秒"/>
                                            <ComboBoxItem Content="30秒"/>
                                        </ComboBox>
                                    </Grid>
                                 </StackPanel>
                            </local:CrispShadowBorder>
                            <local:CrispShadowBorder CornerRadius="10"
                                                     Background="{DynamicResource Brush.Surface.Raised}"
                                                     BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                     BorderThickness="1"
                                                     Margin="5">
                                <local:CrispShadowBorder.ShadowEffect>
                                    <DropShadowEffect BlurRadius="10" 
  ShadowDepth="0" 
  Color="{DynamicResource Color.Shadow.Surface}"
  Opacity="0.2"/>
                                </local:CrispShadowBorder.ShadowEffect>
                                <StackPanel Orientation="Vertical"
                                            Margin="0,5,0,5"
                                            RenderOptions.ClearTypeHint="Enabled">

                                    <Grid Margin="5,0,5,0">
                                        <Label Content="主题"
                                               FontWeight="DemiBold"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Padding="5,3,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="选择应用的配色主题"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Padding="5,0,0,3"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                                        <ComboBox x:Name="ThemeSelector"
                                                  ItemsSource="{Binding ThemeOptions}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding SelectedThemeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DropDownOpened="ThemeSelector_DropDownOpened"
                                                  Style="{StaticResource RoundedComboBoxStyle2}"
                                                  Height="24"
                                                  Width="86"
                                                  HorizontalAlignment="Right"
                                                  Margin="0,8,5,8"
                                                  BorderThickness="1"
                                                  Background="{DynamicResource Brush.Control.FillSubtle}"
                                                  AutomationProperties.Name="主题"
                                                  AutomationProperties.HelpText="选择已验证的应用配色主题" />
                                    </Grid>
                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid Margin="5,0,5,0">
                                            <Label Content="增强动画效果" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="开启可提升动画效果，但可能导致卡顿掉帧" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>

                                        <local:MySwitch IsOn="{Binding EnableAdvancedAnimation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8"  SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>

                                        </Grid>
                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid Margin="5,0,5,0">
                                        <Label Content="显示条目数量" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="同屏显示的剪贴板条目数量" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <ComboBox SelectedIndex="{Binding DisPlayItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource RoundedComboBoxStyle2}" Height="24" Width="86"  HorizontalAlignment="Right" Margin="0,8,5,8" BorderThickness="1" Background="{DynamicResource Brush.Control.FillSubtle}">

                                            <ComboBoxItem Content="3条"/>
                                            <ComboBoxItem Content="4条"/>
                                            <ComboBoxItem Content="5条"/>
                                            <ComboBoxItem Content="6条"/>
                                        </ComboBox>
                                    </Grid>


                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>


                                    <Grid Margin="5,0,5,0">
                                        <Label Content="显示字体大小" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="字体大小会同时改变每项显示的行数" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <ComboBox SelectedIndex="{Binding TextSizeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource RoundedComboBoxStyle2}" Height="24" Width="86"  HorizontalAlignment="Right" Margin="0,8,5,8" BorderThickness="1" Background="{DynamicResource Brush.Control.FillSubtle}">

                                            <ComboBoxItem Content="小"/>
                                            <ComboBoxItem Content="中"/>
                                            <ComboBoxItem Content="大"/>

                                        </ComboBox>
                                    </Grid>


                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid Margin="5,0,5,0"  Height="40">
                                        <Label Content="窗体动画灵敏度" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="数值越低越柔和，数值越高越迅捷" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>

                                        <TextBox HorizontalContentAlignment="Center"  Text="{Binding SmoothFactor, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Right" Width="86" Style="{StaticResource WatermarkTextBoxStyle}" Background="{DynamicResource Brush.Control.FillSubtle}" Margin="5" PreviewTextInput="NumberValidationTextBox"
         DataObject.Pasting="TextBoxPasting" LostFocus="TextBox_LostFocus" />
                                    </Grid>

                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid Margin="5,0,5,0" Height="40">
                                        <Label Content="窗体不透明度" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="调整主界面与剪贴板条目的整体不透明度" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <ComboBox SelectedIndex="{Binding MainSurfaceOpacityIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource RoundedComboBoxStyle2}"
                                                  Height="24"
                                                  Width="86"
                                                  HorizontalAlignment="Right"
                                                  Margin="0,8,5,8"
                                                  BorderThickness="1"
                                                  Background="{DynamicResource Brush.Control.FillSubtle}">
                                            <ComboBoxItem Content="100%"/>
                                            <ComboBoxItem Content="95%"/>
                                            <ComboBoxItem Content="90%"/>
                                            <ComboBoxItem Content="85%"/>
                                            <ComboBoxItem Content="80%"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid Margin="5,0,5,0" Height="40">
                                        <Label Content="文字条目背景"
                                               FontWeight="DemiBold"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Padding="5,3,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="为文字条目添加半透明图片背景"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Padding="5,0,0,3"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <Button Content="配置背景"
                                                Style="{StaticResource ShortcutCaptureButtonStyle}"
                                                Width="86"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,8,5,8"
                                                Click="TextEntryBackgroundButton_Click"
                                                ToolTip="选择图片、调整不透明度、缩放和位置"
                                                AutomationProperties.Name="配置文字条目背景"/>
                                    </Grid>


                                </StackPanel>
                                
                            </local:CrispShadowBorder>
                            <local:CrispShadowBorder CornerRadius="10"
                                                     Background="{DynamicResource Brush.Surface.Raised}"
                                                     BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                     BorderThickness="1"
                                                     Margin="5">
                                <local:CrispShadowBorder.ShadowEffect>
                                    <DropShadowEffect BlurRadius="10" 
  ShadowDepth="0" 
  Color="{DynamicResource Color.Shadow.Surface}"
  Opacity="0.2"/>
                                </local:CrispShadowBorder.ShadowEffect>
                                <StackPanel Orientation="Vertical"
                                            Margin="0,5,0,5"
                                            RenderOptions.ClearTypeHint="Enabled">
                                    <Grid Margin="5,0,5,0">
                                        <Label Content="删除确认" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="开启后删除条目会进行二次确认" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>

                                        <local:MySwitch IsOn="{Binding DeleteConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="12" Width="50" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,8,5,8"  SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}" SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}" SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}" SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}" ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>

                                    </Grid>
                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid Margin="5,0,5,0">
                                        <Label Content="重复复制时清理旧条目" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="重复复制相同内容时，仅保留新复制条目" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>

                                        <local:MySwitch IsOn="{Binding RemoveOldDuplicateEntriesOnCopy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CornerRadius="12"
                                                        Width="50"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,8,5,8"
                                                        AutomationProperties.Name="重复复制时清理旧条目"
                                                        AutomationProperties.HelpText="开启后，重复复制相同内容会保留最新条目并删除较早的相同条目"
                                                        SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}"
                                                        SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}"
                                                        SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}"
                                                        SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}"
                                                        ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                    </Grid>

                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid Margin="5,0,5,0">
                                        <Label Content="支持图片" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="开启后支持复制图片" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>

                                        <local:MySwitch x:Name="ImageSupportSwitch"
                                                        IsOn="{Binding EnableImageSupport, Mode=OneWay}"
                                                        SwitchChanged="ImageSupportSwitch_SwitchChanged"
                                                        CornerRadius="12"
                                                        Width="50"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,8,5,8"
                                                        SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}"
                                                        SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}"
                                                        SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}"
                                                        SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}"
                                                        ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                    </Grid>
                                    <Border Margin="10,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid Margin="5,0,5,0"  Height="40">
                                        <Label Content="条目最大数量" FontWeight="DemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,3,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <Label Content="达到最大数量后，旧的记录将不再保留" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="5,0,0,3" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"/>

                                        <TextBox HorizontalContentAlignment="Center"  Text="{Binding MaxHistoryItems, UpdateSourceTrigger=LostFocus}" HorizontalAlignment="Right" Width="86" Style="{StaticResource WatermarkTextBoxStyle}" Background="{DynamicResource Brush.Control.FillSubtle}" Margin="5" PreviewTextInput="NumberValidationTextBox2"
         DataObject.Pasting="TextBoxPasting2" LostFocus="TextBox_LostFocus2" />
                                    </Grid>

                                </StackPanel>

                            </local:CrispShadowBorder>
                        </StackPanel>

                   
                        
                    </ScrollViewer>
                </TabItem>

                    <!-- 快捷键设置页 -->
                    <TabItem Header="快捷键">
                        <ScrollViewer Padding="0" VerticalScrollBarVisibility="Visible" Margin="0,0,0,0">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar"
                                       BasedOn="{StaticResource ScrollBarThin}">
                                    <Setter Property="Margin" Value="0,0,0,12"/>
                                </Style>
                            </ScrollViewer.Resources>

                            <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                                <local:CrispShadowBorder CornerRadius="10"
                                                         Background="{DynamicResource Brush.Surface.Raised}"
                                                         BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                         BorderThickness="1"
                                                         Margin="5">
                                    <local:CrispShadowBorder.ShadowEffect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Color="{DynamicResource Color.Shadow.Surface}"
                                                          Opacity="0.2"/>
                                    </local:CrispShadowBorder.ShadowEffect>
                                <Grid Margin="5"
                                      RenderOptions.ClearTypeHint="Enabled">
                                    <Label Content="快捷键拦截"
                                                   Padding="5,3,0,0"
                                                   FontWeight="DemiBold"
                                                   VerticalAlignment="Top"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <Label Content="开启后，快捷键不会继续传递"
                                                   Padding="5,0,0,3"
                                                   FontSize="12"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <local:MySwitch IsOn="{Binding InterceptHotkeys, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CornerRadius="12"
                                                        Width="50"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,8,5,8"
                                                        AutomationProperties.Name="拦截快捷键"
                                                        AutomationProperties.HelpText="关闭后快捷键仍会执行，但原按键也会传给当前应用"
                                                        SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}"
                                                        SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}"
                                                        SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}"
                                                        SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}"
                                                        ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                    </Grid>
                                 </local:CrispShadowBorder>

                                 <local:CrispShadowBorder CornerRadius="10"
                                                         Background="{DynamicResource Brush.Surface.Raised}"
                                                         BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                         BorderThickness="1"
                                                         Margin="5">
                                    <local:CrispShadowBorder.ShadowEffect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Color="{DynamicResource Color.Shadow.Surface}"
                                                          Opacity="0.2"/>
                                    </local:CrispShadowBorder.ShadowEffect>
                                    <Grid Margin="5"
                                          RenderOptions.ClearTypeHint="Enabled">
                                        <Label Content="接管 Windows 剪贴板"
                                               Padding="5,3,0,0"
                                               FontWeight="DemiBold"
                                               VerticalAlignment="Top"
                                               FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <Label Content="Win + V 打开 SuperCV"
                                               Padding="5,0,0,3"
                                               FontSize="12"
                                               VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <local:MySwitch IsOn="{Binding TakeOverWindowsClipboardShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        CornerRadius="12"
                                                        Width="50"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,8,5,8"
                                                        AutomationProperties.Name="接管 Windows 剪贴板快捷键"
                                                        AutomationProperties.HelpText="开启后按 Win 加 V 会打开 SuperCV，并阻止 Windows 系统剪贴板弹出"
                                                        SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}"
                                                        SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}"
                                                        SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}"
                                                        SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}"
                                                        ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"/>
                                    </Grid>
                                </local:CrispShadowBorder>

                                <local:CrispShadowBorder CornerRadius="10"
                                                         Background="{DynamicResource Brush.Surface.Raised}"
                                                         BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                         BorderThickness="1"
                                                         Margin="5">
                                    <local:CrispShadowBorder.ShadowEffect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Color="{DynamicResource Color.Shadow.Surface}"
                                                          Opacity="0.2"/>
                                    </local:CrispShadowBorder.ShadowEffect>
                                    <StackPanel Margin="5"
                                                RenderOptions.ClearTypeHint="Enabled">
                                        <Grid>

                                                <Label Content="粘贴最近条目"
                                                       FontWeight="DemiBold"
                                                       Padding="5,3,0,0"
                                                       FontSize="14"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                <Label Content="修饰键可改，数字键固定 1 2 ……"
                                                       Padding="5,0,0,3"
                                                       FontSize="12"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"/>

                                            <Button Tag="AbsoluteEntriesModifiers"
                                                    Content="{Binding AbsoluteEntriesModifiersDisplay}"
                                                    Style="{StaticResource ShortcutCaptureButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Click="ShortcutButton_Click"
                                                    ToolTip="点击后按下新的修饰键组合"
                                                    Margin="0,8,5,8"
                                                    AutomationProperties.Name="最前面十个条目的修饰键"/>
                                        </Grid>
                                    <Border Margin="5,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <Label Content="粘贴可见条目"
                                                       FontWeight="DemiBold"
                                                       Padding="5,3,0,0"
                                                       VerticalAlignment="Top"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                <Label Content="修饰键可改，字母键固定 Q W ……"
                                                       Padding="5,0,0,3"
                                                       FontSize="12"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            </StackPanel>
                                            <Button Tag="VisibleEntriesModifiers"
                                                    Content="{Binding VisibleEntriesModifiersDisplay}"
                                                    Style="{StaticResource ShortcutCaptureButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Click="ShortcutButton_Click"
                                                    ToolTip="点击后按下新的修饰键组合"
                                                    Margin="0,8,5,8"
                                                    AutomationProperties.Name="当前可见条目的修饰键"/>
                                        </Grid>
                                    </StackPanel>
                                </local:CrispShadowBorder>

                                <local:CrispShadowBorder CornerRadius="10"
                                                         Background="{DynamicResource Brush.Surface.Raised}"
                                                         BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                         BorderThickness="1"
                                                         Margin="5">
                                    <local:CrispShadowBorder.ShadowEffect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="0"
                                                          Color="{DynamicResource Color.Shadow.Surface}"
                                                          Opacity="0.2"/>
                                    </local:CrispShadowBorder.ShadowEffect>
                                    <StackPanel Margin="5"
                                                RenderOptions.ClearTypeHint="Enabled">
                                        <Grid>

                                                <Label Content="移动主窗口"
                                                       FontWeight="DemiBold"
                                                       Padding="5,3,0,0"
                                                       VerticalAlignment="Top"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                <Label Content="将 SuperCV 移到鼠标位置"
                                                       Padding="5,0,0,3"
                                                       VerticalAlignment="Bottom"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"/>

                                            <Button Tag="MoveWindow"
                                                    Content="{Binding MoveWindowShortcutDisplay}"
                                                    Style="{StaticResource ShortcutCaptureButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Click="ShortcutButton_Click"
                                                    ToolTip="点击后按下新的组合键或鼠标键"
                                                    Margin="0,8,5,8"
                                                    AutomationProperties.Name="移动主窗口快捷键"/>
                                        </Grid>
                                    <Border Margin="5,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid>

                                                <Label Content="向后粘贴"
                                                       FontWeight="DemiBold"
                                                       VerticalAlignment="Top"
                                                       Padding="5,3,0,0"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                <Label Content="从上次位置继续粘贴更旧条目"
                                                       Padding="5,0,0,3"
                                                       VerticalAlignment="Bottom"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"/>

                                            <Button Tag="PasteOlder"
                                                    Content="{Binding PasteOlderShortcutDisplay}"
                                                    Style="{StaticResource ShortcutCaptureButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Click="ShortcutButton_Click"
                                                    Margin="0,8,5,8"
                                                    ToolTip="点击后按下新的组合键或鼠标键"
                                                    AutomationProperties.Name="向后粘贴快捷键"/>
                                        </Grid>
                                    <Border Margin="5,2" Background="{DynamicResource Brush.Separator.Default}" Height="1"/>

                                    <Grid>

                                                <Label Content="向前粘贴"
                                                       FontWeight="DemiBold"
                                                       Padding="5,3,0,0"
                                                       FontSize="14"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                <Label Content="从上次位置继续粘贴更新条目"
                                                       Padding="5,0,0,3"
                                                       FontSize="12"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"/>

                                            <Button Tag="PasteNewer"
                                                    Content="{Binding PasteNewerShortcutDisplay}"
                                                    Style="{StaticResource ShortcutCaptureButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Click="ShortcutButton_Click"
                                                    Margin="0,8,5,8"
                                                    ToolTip="点击后按下新的组合键或鼠标键"
                                                    AutomationProperties.Name="向前粘贴快捷键"/>
                                        </Grid>
                                    </StackPanel>
                                </local:CrispShadowBorder>


                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 历史记录设置页 -->
                    <TabItem Header="历史记录">
                        <Grid Margin="5,0,5,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <local:CrispShadowBorder CornerRadius="10"
                                                     Background="{DynamicResource Brush.Surface.Raised}"
                                                     BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                     BorderThickness="1"
                                                     Margin="5">
                                <local:CrispShadowBorder.ShadowEffect>
                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Color="{DynamicResource Color.Shadow.Surface}"
                                                      Opacity="0.2"/>
                                </local:CrispShadowBorder.ShadowEffect>
                                <StackPanel Margin="0,5"
                                            RenderOptions.ClearTypeHint="Enabled">
                                    <Grid Margin="5,0">
                                        <Label Content="长久储存"
                                               FontWeight="DemiBold"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"
                                               Padding="5,3,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        <Label Content="每个工作区独立保留，最多 99,999 条"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Padding="5,0,0,3"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <local:MySwitch x:Name="PersistentHistorySwitch"
                                                        IsOn="{Binding PersistentHistoryEnabled, Mode=OneWay}"
                                                        SwitchChanged="PersistentHistorySwitch_SwitchChanged"
                                                        CornerRadius="12"
                                                        Width="50"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,8,5,8"
                                                        SwitchColorOn="{DynamicResource Color.Toggle.TrackOn}"
                                                        SwitchColorOff="{DynamicResource Color.Toggle.TrackOff}"
                                                        SwitchColorOver="{DynamicResource Color.Toggle.TrackOnHover}"
                                                        SwitchColorOver2="{DynamicResource Color.Toggle.ThumbHover}"
                                                        ButtonForeColor="{DynamicResource Color.Toggle.Thumb}"
                                                        AutomationProperties.Name="长久储存历史记录"/>
                                    </Grid>
                                </StackPanel>
                            </local:CrispShadowBorder>

                            <local:CrispShadowBorder Grid.Row="1"
                                                     CornerRadius="10"
                                                     Background="{DynamicResource Brush.Surface.Raised}"
                                                     BorderBrush="{DynamicResource Brush.Border.Soft}"
                                                     BorderThickness="1"
                                                     Margin="5,5,5,10"
                                                     Visibility="{Binding PersistentHistorySettingsVisibility}">
                                <local:CrispShadowBorder.ShadowEffect>
                                    <DropShadowEffect BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Color="{DynamicResource Color.Shadow.Surface}"
                                                      Opacity="0.2"/>
                                </local:CrispShadowBorder.ShadowEffect>
                                    <Grid Margin="0,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="16"/>
                                        </Grid.RowDefinitions>

                                        <Grid Margin="5,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                        
                                        <Grid Grid.Column="1"
                                              Grid.Row="0"
                                              Width="130"
                                              Margin="0,0,5,2"
                                              HorizontalAlignment="Right">
                                            <TextBox x:Name="HistorySearchBox"
                                                     Text="{Binding History.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center"
                                                     Style="{StaticResource WatermarkTextBoxStyle}"
                                                     Background="{DynamicResource Brush.Control.FillSubtle}"
                                                     ToolTip="输入文本后按回车查找"
                                                     AutomationProperties.Name="查找历史条目"
                                                     Loaded="HistorySearchBox_Loaded"
                                                     TextChanged="HistorySearchBox_TextChanged"
                                                     KeyDown="HistorySearchBox_KeyDown"/>
                                            <TextBlock x:Name="HistorySearchWatermark"
                                                       Margin="10,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       IsHitTestVisible="False"
                                                       Text="输入内容查找"/>
                                        </Grid>
                                        <local:HistoryDateRangePicker Grid.Column="0"
                                                                      Margin="5,0,0,2"
                                                                      
                                                                      HorizontalAlignment="Stretch"
                                                                      StartDate="{Binding History.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      EndDate="{Binding History.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      DateRangeChanged="HistoryDateRange_DateRangeChanged"/>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Margin="0"
                                            Background="{DynamicResource Brush.Separator.Default}"/>

                                    <ListBox x:Name="HistoryList"
                                             Grid.Row="2"
                                             ItemsSource="{Binding History.Entries}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="5,2,1,2"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.ScrollChanged="HistoryList_ScrollChanged"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             AutomationProperties.Name="持久历史记录">
                                        <ListBox.Resources>
                                            <Style TargetType="ScrollBar"
                                                   BasedOn="{StaticResource ScrollBarThin}">
                                                <Setter Property="Margin" Value="0,0,0,6"/>
                                            </Style>
                                        </ListBox.Resources>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem"
                                                   BasedOn="{StaticResource PointerOnlyControlStyle}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:PersistentHistoryItemViewModel}">
                                                <Grid Height="28" Margin="5,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="66"/>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayId}"
                                                               VerticalAlignment="Center"
                                                               Padding="2,5"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayText}"
                                                               VerticalAlignment="Center"
                                                               Padding="2,5"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CreatedAtDisplay}"
                                                               VerticalAlignment="Center"
                                                               Padding="2,5"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Padding="2,5"
                                                               FontSize="10"
                                                               Cursor="Hand"
                                                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                                               MouseLeftButtonUp="CopyHistoryItem_Click"
                                                               AutomationProperties.Name="复制历史条目">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="复制"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnglish, Source={x:Static local:LocalizationService.Current}}"
                                                                                 Value="True">
                                                                        <Setter Property="Text" Value="Copy"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="4"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Padding="2,5"
                                                               FontSize="10"
                                                               Cursor="Hand"
                                                               Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                                                               MouseLeftButtonUp="DeleteHistoryItem_Click"
                                                               AutomationProperties.Name="删除历史条目">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="删除"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnglish, Source={x:Static local:LocalizationService.Current}}"
                                                                                 Value="True">
                                                                        <Setter Property="Text" Value="Del"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding History.StatusText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
