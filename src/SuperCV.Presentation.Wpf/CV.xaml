<Window x:Class="SuperCV.CV"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:SuperCV"
        Title="CV" 
        Width="310" Height="140"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="{Binding Opacity, Source={x:Static local:MainSurfaceAppearanceState.Current}, Mode=OneWay}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"

        >
    <Window.Resources>
        <DropShadowEffect x:Key="NormalShadow"
              BlurRadius="10"
              ShadowDepth="0"
              Color="{DynamicResource Color.Shadow.Surface}"
                          RenderingBias="Performance"
              Opacity="0.7" />

        <!--
            Supersample only the three action icons. BitmapCache and BitmapScalingMode
            participate in rendering only, so the existing Viewbox bounds, centering,
            button layout, and icon shadows remain unchanged. Pixel snapping is kept
            disabled to avoid moving an icon at fractional DPI.
        -->
        <Style x:Key="CvActionIconRenderQualityStyle"
               TargetType="{x:Type Viewbox}">
            <Setter Property="RenderOptions.BitmapScalingMode"
                    Value="HighQuality"/>
            <Setter Property="CacheMode">
                <Setter.Value>
                    <BitmapCache RenderAtScale="2"
                                 EnableClearType="False"
                                 SnapsToDevicePixels="False"/>
                </Setter.Value>
            </Setter>
        </Style>



    </Window.Resources>





        <!-- 窗口阴影和圆角效果 -->
        <Grid x:Name="MainBorder"
              Margin="10"
              Width="280"
              Height="110">
            <Border CornerRadius="20"
                    Background="{DynamicResource Brush.Surface.Window}"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <StaticResource ResourceKey="NormalShadow" />
                </Border.Effect>
            </Border>

            <Border CornerRadius="20"
                    Background="{DynamicResource Brush.Surface.Window}"
                    RenderOptions.ClearTypeHint="Enabled">

                
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="DragPanel" 
                      Width="35"
                      Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="ButtonDelete" Margin="5,0,0,5" Grid.Row="2" Style="{StaticResource baseButtonStyle}" Background="{DynamicResource Brush.Surface.Raised}" Click="Button_Delete" ToolTip="删除当前条目">
                        <Viewbox Width="19"
                                 Height="19"
                                 Style="{StaticResource CvActionIconRenderQualityStyle}">
                            <StaticResource ResourceKey="Delete"/>
                        </Viewbox>
                    </Button>

                    <Button  Grid.Row="1" Margin="5,5,0,5" Style="{StaticResource baseButtonStyle}" Background="{DynamicResource Brush.Surface.Raised}" Click="Button_Click" ToolTip="打开操作菜单">
                        <Viewbox Width="17"
                                 Height="17"
                                 Style="{StaticResource CvActionIconRenderQualityStyle}">
                            <StaticResource ResourceKey="Menu"/>
                        </Viewbox>
                    </Button>
                        <Button x:Name="AiPrimaryActionButton"
                                Grid.Row="0"
                                Margin="5,5,0,0"
                                Background="{DynamicResource Brush.Surface.Raised}"
                                Click="Button_Click_2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource baseButtonStyle}">
                                    <Setter Property="ToolTip" Value="AI 文本处理"/>
                                    <Setter Property="AutomationProperties.Name" Value="AI 文本处理"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:AiFeatureAvailabilityState.Current}}"
                                                     Value="False">
                                            <Setter Property="ToolTip" Value="置顶"/>
                                            <Setter Property="AutomationProperties.Name" Value="置顶"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter Property="ToolTip" Value="置顶"/>
                                            <Setter Property="AutomationProperties.Name" Value="置顶"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid x:Name="ContentGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="LoadingStates">
                                        <!-- 正常状态 -->
                                        <VisualState x:Name="NormalState">
                                            <Storyboard>
                                                <!-- 显示正常图标，隐藏加载图标 -->
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NormalViewbox" 
                                                                   Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoadingViewbox" 
                                                                   Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <!-- 停止旋转动画 -->
                                                <DoubleAnimation Storyboard.TargetName="LoadingRotateTransform" 
                                                     Storyboard.TargetProperty="Angle"
                                                     To="0" Duration="0:0:0"/>
                                            </Storyboard>
                                        </VisualState>

                                        <!-- 加载状态 -->
                                        <VisualState x:Name="LoadingState">
                                            <Storyboard RepeatBehavior="Forever">
                                                <!-- 隐藏正常图标，显示加载图标 -->
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NormalViewbox" 
                                                                   Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LoadingViewbox" 
                                                                   Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <!-- 旋转动画 - 无限循环 -->
                                                <DoubleAnimation Storyboard.TargetName="LoadingRotateTransform" 
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" 
                                                     Duration="0:0:0.85"
                                                     RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>


                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:AiFeatureAvailabilityState.Current}}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- 正常状态：显示 Ai 文本 -->
                                    <Viewbox x:Name="NormalViewbox"
                                             Width="30"
                                             Height="30"
                                             Style="{StaticResource CvActionIconRenderQualityStyle}">
                                        <Label Content="AI" FontSize="24" FontFamily="Arial" FontWeight="SemiBold">
                                            <Label.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{DynamicResource Color.AiAccent.Start}" Offset="0.0"/>
                                                    <GradientStop Color="{DynamicResource Color.AiAccent.Middle}" Offset="0.5"/>
                                                    <GradientStop Color="{DynamicResource Color.AiAccent.End}" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Label.Foreground>
                                        </Label>
                                        
                                    </Viewbox>

                                    <!-- 加载状态：弱轨道搭配单段圆角渐变弧，保持小尺寸下的清晰度。 -->
                                    <Viewbox x:Name="LoadingViewbox" Width="22" Height="22" Visibility="Collapsed">
                                        <Grid Width="20" Height="20">
                                            <Ellipse Width="18"
                                                     Height="18"
                                                     Stroke="{DynamicResource Brush.Ai.ProgressTrack}"
                                                     StrokeThickness="2"/>
                                            <Path Data="M 4.04,4.04 A 8.43,8.43 0 1 1 4.04,15.96"
                                                  StrokeThickness="2.25"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Stroke>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{DynamicResource Color.AiAccent.Start}" Offset="0.0"/>
                                                    <GradientStop Color="{DynamicResource Color.AiAccent.Middle}" Offset="0.5"/>
                                                    <GradientStop Color="{DynamicResource Color.AiAccent.End}" Offset="1.0"/>
                                                </LinearGradientBrush>
                                                </Path.Stroke>
                                                <Path.RenderTransform>
                                                <RotateTransform x:Name="LoadingRotateTransform" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Viewbox>
                                </Grid>

                                <Viewbox Width="18"
                                         Height="18"
                                         >
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox"
                                               BasedOn="{StaticResource CvActionIconRenderQualityStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:AiFeatureAvailabilityState.Current}}"
                                                             Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <StaticResource ResourceKey="CVAiDisabledPinIcon"/>
                                </Viewbox>
                            </Grid>
                        </Button>
                    <Popup x:Name="CustomPopup" 
        PlacementTarget="{Binding ElementName=TextBorder}"
        Placement="RelativePoint"
        HorizontalOffset="5"
        VerticalOffset="5"
        StaysOpen="False"
        AllowsTransparency="True"
        Closed="CustomPopup_Closed">

                        <local:CrispShadowBorder x:Name="CustomPopupContent"
                                Background="{DynamicResource Brush.Surface.Raised}"
                                Opacity="{Binding Opacity, Source={x:Static local:MainSurfaceAppearanceState.Current}, Mode=OneWay}"
                                CornerRadius="10"
             Width="120"  Margin="20">
                            <local:CrispShadowBorder.ShadowEffect>
                                <DropShadowEffect 
                                  BlurRadius="12"
                                  ShadowDepth="0"
                                  Color="{DynamicResource Color.Shadow.Surface}"
                                  Opacity="0.8" />
                            </local:CrispShadowBorder.ShadowEffect>
                            <Grid RenderOptions.ClearTypeHint="Enabled">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="29"/>

                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="3,3,3,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition>
                                            <ColumnDefinition.Style>
                                                <Style TargetType="ColumnDefinition">
                                                    <Setter Property="Width" Value="1*"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                            <Setter Property="Width" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ColumnDefinition.Style>
                                        </ColumnDefinition>
                                        <ColumnDefinition>
                                            <ColumnDefinition.Style>
                                                <Style TargetType="ColumnDefinition">
                                                    <Setter Property="Width" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                            <Setter Property="Width" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ColumnDefinition.Style>
                                        </ColumnDefinition>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BookmarkButton"
                                            Style="{StaticResource roundButtonStyle}"
                                            BorderThickness="0"
                                            Background="{DynamicResource Brush.Surface.Raised}"
                                            Click="Button_Click_3"
                                            ToolTip="添加书签"
                                            Visibility="{Binding TextContentVisibility}">
                                        <Button.Content>
                                            
                                                
                                            
                                            <Viewbox  Width="15" Height="15">
                                                <StaticResource ResourceKey="Star"/>
                                            </Viewbox>

                                        </Button.Content>
                                    </Button>
                                    <Border Grid.Column="1"
                                            Width="0.5"
                                            Margin="0,5"
                                            Background="{DynamicResource Brush.Separator.Strong}"
                                            Visibility="{Binding TextContentVisibility}"/>
                                    <Button Grid.Column="2"  Style="{StaticResource roundButtonStyle}"  BorderThickness="0"   Background="{DynamicResource Brush.Surface.Raised}" Click="Button_Click_6" ToolTip="置顶">
                                        <Button.Content>
                                            


                                                <Viewbox Width="15" Height="15">
                                                    <StaticResource ResourceKey="PinTop"/>
                                                </Viewbox>

                                        </Button.Content>
                                    </Button>
                                    <Border Grid.Column="3" Width="0.5" Margin="0,5" Background="{DynamicResource Brush.Separator.Strong}"/>
                                    <Button x:Name="ExportButton"
                                            Grid.Column="4"
                                            Style="{StaticResource roundButtonStyle}"
                                            BorderThickness="0"
                                            Background="{DynamicResource Brush.Surface.Raised}"
                                            Click="ExportButton_Click"
                                            ToolTip="导出"
                                            AutomationProperties.Name="导出">
                                        <Button.Content>
                                           

                                                <Viewbox  Width="15" Height="15">
                                                    <StaticResource ResourceKey="ExportDocumentIcon"/>
                                                </Viewbox>

                                        </Button.Content>
                                    </Button>


                                </Grid>

     <StackPanel Margin="3,0,3,3" Grid.Row="1">

                                    <Button x:Name="OpenImageButton"
                                            Style="{StaticResource moreButtonStyle}"
                                            Padding="8,0,8,0"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Content="打开图片"
                                            Height="26"
                                            Background="{DynamicResource Brush.Surface.Raised}"
                                            FontSize="14"
                                            Foreground="{DynamicResource Brush.Text.Primary}"
                                            Visibility="{Binding ImageContentVisibility}"
                                            ToolTip="使用 Windows 默认应用打开图片"
                                            AutomationProperties.Name="使用 Windows 默认应用打开图片"
                                            Click="OpenImageButton_Click"/>




                                    <Button x:Name="RevokeButton"
                                            Padding="8,0,8,0"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Content="撤销修改"
                                            Height="26"
                                            FontSize="14"
                                            AutomationProperties.Name="撤销修改"
                                            AutomationProperties.HelpText="没有可撤销记录时不可用"
                                            Visibility="{Binding TextContentVisibility}"
                                            Click="Button_Click_10">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource moreButtonStyle}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>


                                    <Button x:Name="PureTextButton" Style="{StaticResource moreButtonStyle}" Padding="8,0,8,0" BorderThickness="0" HorizontalContentAlignment="Left" Content="转换为纯文本" Height="26" Background="{DynamicResource Brush.Surface.Raised}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" Visibility="{Binding TextContentVisibility}" Click="Button_Click_5"/>


                                <Button x:Name="FindReplaceButton" Style="{StaticResource moreButtonStyle}" Padding="8,0,8,0" BorderThickness="0" HorizontalContentAlignment="Left" Content="查找替换" Height="26" Background="{DynamicResource Brush.Surface.Raised}"  FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" Visibility="{Binding TextContentVisibility}" Click="Button_Click_9" />

                                <Button x:Name="WebSearchButton"
                                        Style="{StaticResource moreButtonStyle}"
                                        Padding="8,0,8,0"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Content="网络搜索"
                                        Height="26"
                                        Background="{DynamicResource Brush.Surface.Raised}"
                                        FontSize="14"
                                        Foreground="{DynamicResource Brush.Text.Primary}"
                                        Visibility="{Binding TextContentVisibility}"
                                        ToolTip="使用默认浏览器搜索此条目"
                                        AutomationProperties.Name="网络搜索"
                                        Click="WebSearchButton_Click"/>

                                <Button x:Name="ColorMenuButton"
        Style="{StaticResource moreButtonStyle}" 
        Padding="8,0,8,0" 
        BorderThickness="0" 
        Height="26" 
                     HorizontalContentAlignment="Left"                       
        Background="{DynamicResource Brush.Surface.Raised}"
        FontSize="14" 
        Foreground="{DynamicResource Brush.Text.Primary}"
        Click="Button_Click_8"
        MouseEnter="ColorMenuButton_MouseEnter"
        MouseLeave="ColorMenuButton_MouseLeave">

                                    <!-- 取消了外部的 Content 属性，在这里重新定义内部内容 -->
                                    <Grid >
                                        

                                        <!-- 1. 左侧文字：TextBlock会自动继承外部Button的 FontSize="14" 和 Foreground，保证大小和原来绝对一致 -->
                                        <TextBlock 
                   Text="颜色标记" 
                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>

                                        <!-- 2. 右侧图标：使用 Viewbox 包裹，限制好大小 -->
                                        <Viewbox  
                 Width="12" Height="12" 
                 Margin="85,0,0,0" 
                      HorizontalAlignment="Right"                          
                 VerticalAlignment="Center">
                                            <!-- 因为你的 Path 设置了 x:Shared="False"，这是正确的做法，使用 ContentControl 引用它 -->
                                            <ContentControl Content="{StaticResource Right}"/>
                                        </Viewbox>
                                    </Grid>

                                </Button>
                            </StackPanel>
                            </Grid>
                        </local:CrispShadowBorder>
                    </Popup>
                        <Popup x:Name="ColorPopup" 
PlacementTarget="{Binding ElementName=TextBorder}"
Placement="RelativePoint"
HorizontalOffset="130"
 VerticalOffset="5"
 StaysOpen="True"
 AllowsTransparency="True">

                            <Border x:Name="ColorPopupContent"
                                    Background="{DynamicResource Brush.Surface.Raised}"
                                    Opacity="{Binding Opacity, Source={x:Static local:MainSurfaceAppearanceState.Current}, Mode=OneWay}"
                                    CornerRadius="10"
     Width="100"  Margin="20"
                                    MouseEnter="ColorPopup_MouseEnter"
                                    MouseLeave="ColorPopup_MouseLeave">
                                <Border.Effect>
                                    <DropShadowEffect 
                           BlurRadius="12"
                           ShadowDepth="0"
                           Color="{DynamicResource Color.Shadow.Surface}"
                           Opacity="0.8" />
                                </Border.Effect>
                                <StackPanel x:Name="ColorStackPanel" Margin="3">



                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup x:Name="AIPopup" 
                       PlacementTarget="{Binding ElementName=MainBorder}"
                       Placement="RelativePoint"
                       HorizontalOffset="0"
                       VerticalOffset="-65"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       GotFocus="AIPopup_GotFocus">
                            <Grid Width="Auto"
                                  Height="Auto"
                                  Margin="15"
                                  Opacity="{Binding Opacity, Source={x:Static local:MainSurfaceAppearanceState.Current}, Mode=OneWay}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <local:CrispShadowBorder Grid.Row="0" Background="{DynamicResource Brush.Surface.Window}" CornerRadius="20"
                                    Width="280"  HorizontalAlignment="Left" Height="60">
                                    <local:CrispShadowBorder.ShadowEffect>
                                        <StaticResource ResourceKey="NormalShadow" />
                                    </local:CrispShadowBorder.ShadowEffect>



                                        <Border Grid.Column="0"
                                                Margin="10"
                                                CornerRadius="10"
                                                Background="{DynamicResource Brush.Surface.Raised}"
                                                BorderBrush="{DynamicResource Brush.Border.Control}"
                                                BorderThickness="1"
                                                RenderOptions.ClearTypeHint="Enabled">


                                            <Grid>
                                                <TextBox x:Name="AITextBox"
                                                         BorderThickness="0" 
                                                         Background="Transparent" 
                                                         Padding="6,6,35,6"
                                                         FontSize="16"
                                                         SelectionBrush="{DynamicResource Brush.Text.Selection}" CaretBrush="{DynamicResource Brush.Text.Caret}"
                                                         Foreground="{DynamicResource Brush.Text.Primary}"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding Question, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="输入问题" KeyDown="AITextBox_KeyDown"/>
                                                <TextBlock IsHitTestVisible="False" Text="直接问AI"   Padding="10,6"
                                                         FontSize="16"  
                                                         Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=AITextBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button 
                                                    Width="26"
                                                    Height="26"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Background="#5686fe"
                                                    BorderThickness="0"
                                                    Foreground="White"
                                                    Click="Button_Click_7"  
                                                    Cursor="Hand"
                                                    ToolTip="发送问题（Enter）">

                                                    <!-- 自定义模板实现圆形外观和交互效果 -->
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="20">

                                                                <VisualStateManager.VisualStateGroups>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <!-- 普通状态 -->
                                                                        <VisualState x:Name="Normal"/>

                                                                        <!-- 鼠标悬停状态 - 颜色加深 -->
                                                                        <VisualState x:Name="MouseOver">
                                                                            <Storyboard>
                                                                                <ColorAnimation 
                            Storyboard.TargetName="border" 
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="#4d79e5" 
                            Duration="0:0:0.2"/>
                                                                            </Storyboard>
                                                                        </VisualState>

                                                                        <!-- 鼠标按下状态 - 更深颜色 -->
                                                                        <VisualState x:Name="Pressed">
                                                                            <Storyboard>
                                                                                <ColorAnimation 
                            Storyboard.TargetName="border" 
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="#456bcb" 
                            Duration="0:0:0.1"/>
                                                                            </Storyboard>
                                                                        </VisualState>

                                                                        <!-- 禁用状态 -->
                                                                        <VisualState x:Name="Disabled">
                                                                            <Storyboard>
                                                                                <ColorAnimation 
                            Storyboard.TargetName="border" 
                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                            To="#89aafe" 
                            Duration="0"/>
                                                                            </Storyboard>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateManager.VisualStateGroups>

                                                                <!-- 半径为宽度/40的一半，即20 -->
                                                                <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>

                                                    <!-- 白色向上箭头图标（使用Segoe MDL2 Assets字体） -->
                                                    <Viewbox Width="15"
                                                             Height="15"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             UseLayoutRounding="False"
                                                             SnapsToDevicePixels="False">
                                                        <StaticResource ResourceKey="ArrowUp" />
                                                    </Viewbox>
                                                </Button>
                                            </Grid>

                                        </Border>




                                </local:CrispShadowBorder>
                                <local:CrispShadowBorder Grid.Row="1" Background="{DynamicResource Brush.Surface.Raised}" CornerRadius="10"
                                    Width="145" HorizontalAlignment="Left" Margin="45,15,0,0">
                                    <local:CrispShadowBorder.ShadowEffect>
                                        <DropShadowEffect 
                      BlurRadius="12"
                      ShadowDepth="0"
                      Color="{DynamicResource Color.Shadow.Surface}"
                      Opacity="0.8" />
                                    </local:CrispShadowBorder.ShadowEffect>
                                    <Grid Margin="3"
                                          RenderOptions.ClearTypeHint="Enabled">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                    <Border Grid.Row="1"
                                            VerticalAlignment="Top"
                                            Height="1"
                                            Margin="2"
                                            HorizontalAlignment="Stretch"
                                            BorderThickness="0"
                                            Background="{DynamicResource Brush.Separator.Default}"
                                            Visibility="{Binding Visibility, ElementName=AIInstructionListScrollViewer}"/>
                                    <ScrollViewer x:Name="AIInstructionListScrollViewer"
                                                  Grid.Row="1"
                                                  MaxHeight="130"
                                                  Padding="0"
                                                  VerticalScrollBarVisibility="Visible"
                                                  Margin="0,5,-3,0">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, ElementName=AIList}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ScrollViewer.Resources>
                                                <!-- 直接在这里定义或引用滚动条样式 -->
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarThin2}"/>
                                            </ScrollViewer.Resources>
                                            <StackPanel x:Name="AIList" Tag="0">


                                           
                                        </StackPanel>

                                        </ScrollViewer>
                                        <Button Margin="2" Grid.Row="0" BorderThickness="0.5" BorderBrush="{DynamicResource Brush.Border.Control}" Style="{StaticResource moreButtonStyle1}" HorizontalContentAlignment="Center"   Background="{DynamicResource Brush.Control.FillSubtle}"  FontSize="20" Foreground="{DynamicResource Brush.Text.Primary}" Click="Button_Click_1">
                                            <Button.Content>


                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition  Width="3*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Viewbox  Width="16" Height="16">
                                                    <StaticResource ResourceKey="Plus"/>
                                                </Viewbox>
                                                    <Label Grid.Column="1" Content="添加新指令" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                </Grid>
                                            </Button.Content>
                                        </Button>
                                    </Grid>
                                </local:CrispShadowBorder>
                            </Grid>

                        </Popup>
                </Grid>



                <Grid x:Name="TextBorder"
                    Grid.Column="1"
                    Margin="5,5,5,5"
                    RenderTransformOrigin="0.5,0.5"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="ClearType"
                    TextOptions.TextHintingMode="Fixed"
                    UseLayoutRounding="False"
                    SnapsToDevicePixels="False"
                     MouseEnter="TextBorder_MouseEnter" MouseLeave="TextBorder_MouseLeave"
                    MouseUp="TextBorder_MouseUp" PreviewMouseWheel="TextBorder_PreviewMouseWheel" PreviewMouseLeftButtonDown="TextBorder_PreviewMouseLeftButtonDown" MouseMove="TextBorder_MouseMove" MouseLeftButtonDown="TextBorder_MouseLeftButtonDown" MouseLeftButtonUp="TextBorder_MouseLeftButtonUp" MouseRightButtonDown="TextBorder_MouseRightButtonDown" MouseRightButtonUp="TextBorder_MouseRightButtonUp"

                        >
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ContentPressScaleTransform" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="MoveTransform" X="0" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Border x:Name="TextBorderShadowSurface"
                            CornerRadius="15"
                            Background="{DynamicResource Brush.Surface.Raised}"
                            IsHitTestVisible="False">
                        <Border.CacheMode>
                            <BitmapCache EnableClearType="False"
                                         RenderAtScale="1"
                                         SnapsToDevicePixels="True" />
                        </Border.CacheMode>
                        <Border.Effect>
                            <DropShadowEffect x:Name="DynamicShadow"
                                              BlurRadius="1"
                                              ShadowDepth="0"
                                              Color="{DynamicResource Color.Shadow.Content}"
                                              Opacity="0" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="TextBorderContentSurface"
                            CornerRadius="15"
                            RenderOptions.BitmapScalingMode="{Binding ImageBitmapScalingMode}"
                            RenderOptions.ClearTypeHint="Enabled">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- 设置默认背景（非悬停状态） -->
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Soft}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Control.Highlight}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />

                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="{Binding ImageSource}"
                                                            Stretch="UniformToFill"
                                                            AlignmentX="Left"
                                                            AlignmentY="Top"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    <Grid RenderOptions.ClearTypeHint="Enabled">
                        <!-- Text-only cards receive a shared artwork layer.  It deliberately sits
                             above the normal surface but below all text and controls, so the
                             existing hover, border, and image-entry behavior stay intact. -->
                        <Border x:Name="TextEntryBackgroundSurface"
                                Margin="0,0,-1,0"
                                CornerRadius="14"
                                ClipToBounds="True"
                                IsHitTestVisible="False">
                            <!-- Keep one 268 × 98 logical canvas, then reveal its right-hand
                                 portion when the left action rail is visible.  This is the same
                                 coordinate system shown by the large and small dashed previews. -->
                            <local:LogicalTextEntryBackground
                                ImageSource="{Binding BackgroundImageSource, Source={x:Static local:TextEntryBackgroundAppearanceState.Current}}"
                                ImageOpacity="{Binding BackgroundOpacity, Source={x:Static local:TextEntryBackgroundAppearanceState.Current}}"
                                ImageScale="{Binding BackgroundScale, Source={x:Static local:TextEntryBackgroundAppearanceState.Current}}"
                                ImageOffsetX="{Binding BackgroundOffsetX, Source={x:Static local:TextEntryBackgroundAppearanceState.Current}}"
                                ImageOffsetY="{Binding BackgroundOffsetY, Source={x:Static local:TextEntryBackgroundAppearanceState.Current}}"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:TextEntryBackgroundAppearanceState.Current}}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                    <Grid RenderOptions.ClearTypeHint="Enabled">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="ContentClipGeometry"
                                               RadiusX="14"
                                               RadiusY="14"
                                               Rect="0,0,233,98"/>
                        </Grid.Clip>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="17"/>
                        </Grid.RowDefinitions>

                            <Border 
                                Visibility="{Binding TagVisibility}" 
                                Background="{Binding TagColor}" 
                                BorderThickness="0"
                                Grid.RowSpan="2" 
                                Width="5" 
                                CornerRadius="2.5" 
                                Height="32" 
                                HorizontalAlignment="Right" 
                                Margin="3"/>
                        <Grid Visibility="{Binding TopIcon,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3">

                            <local:TriangleBorderShape 
            Fill="{DynamicResource Brush.Icon.Muted}"
            StrokeThickness="0" 
            CornerRadius="3, 12, 3, 0" />

                            

                        </Grid>
                        <TextBlock x:Name="CVTextBlock" Grid.Row="0" Margin="8,4,8,-2" Text="{Binding DisplayCVContent, Mode=OneWay}" FontSize="{Binding TextSize, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}" Visibility="{Binding TextContentVisibility}" MaxHeight="80" TextTrimming="CharacterEllipsis" />

                        <Grid Grid.Row="1"
                              Margin="8,1,8,2"
                              IsHitTestVisible="False">
                            <Grid.Resources>
                                <Style x:Key="MetadataTextStyle" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                                </Style>
                                <Style x:Key="LaunchTimeMetadataTextStyle"
                                       TargetType="TextBlock"
                                       BasedOn="{StaticResource MetadataTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{Binding ImageLaunchTimeForeground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="MetricsMetadataTextStyle"
                                       TargetType="TextBlock"
                                       BasedOn="{StaticResource MetadataTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{Binding ImageMetricsForeground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="IndexMetadataTextStyle"
                                       TargetType="TextBlock"
                                       BasedOn="{StaticResource MetadataTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter Property="Foreground"
                                                    Value="{Binding ImageIndexForeground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ContentMetrics, Mode=OneWay}"
                                       FontSize="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontFamily="Microsoft YaHei UI"
                                       Style="{StaticResource MetricsMetadataTextStyle}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LaunchTime, Mode=OneWay}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="Microsoft YaHei UI"
                                       Style="{StaticResource LaunchTimeMetadataTextStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding IndexShow,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="Microsoft YaHei UI"
                                       Style="{StaticResource IndexMetadataTextStyle}"/>

                        </Grid>
                        
                        </Grid>
                    </Grid>
                    </Border>



                </Grid>
                <Popup x:Name="EditPopup" 
    PlacementTarget="{Binding ElementName=MainBorder}"
    Placement="RelativePoint"
    HorizontalOffset="0"
    VerticalOffset="0"
    StaysOpen="False"
    AllowsTransparency="True"
    GotFocus="EditPopup_GotFocus"
    Closed="EditPopup_Closed">

                    <local:CrispShadowBorder x:Name="PopBorder"
                            Background="{DynamicResource Brush.Surface.Window}"
                            Opacity="{Binding Opacity, Source={x:Static local:MainSurfaceAppearanceState.Current}, Mode=OneWay}"
                            CornerRadius="20"
        Width="280" Height="{Binding PreviewPopupHeight}"  Margin="20" MouseLeave="Border_MouseLeave"  >
                        
                        <local:CrispShadowBorder.ShadowEffect>
                            <DropShadowEffect x:Name="PopShadow"
   BlurRadius="30"
   ShadowDepth="0"
   Color="{DynamicResource Color.Shadow.Surface}"
   Opacity="0.5" />
                        </local:CrispShadowBorder.ShadowEffect>
                            <Grid Margin="5"
                                  RenderOptions.ClearTypeHint="Enabled">


                           
                                <Border Margin="5" Background="{DynamicResource Brush.Surface.Raised}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Control}" Visibility="{Binding TextContentVisibility}">

                                    <TextBox x:Name="EditBox" ContextMenu="{x:Null}" Margin="2" SelectionBrush="{DynamicResource Brush.Text.Selection}" CaretBrush="{DynamicResource Brush.Text.Caret}" Background="Transparent" BorderThickness="0" TextWrapping="WrapWithOverflow" FontSize="14" AcceptsReturn="True" AcceptsTab="True" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"  PreviewKeyDown="EditBox_PreviewKeyDown">

                                    <TextBox.Resources>
                                        <!-- 应用自定义滚动条样式 -->
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar}"/>
                                    </TextBox.Resources>
                                </TextBox>

                                </Border>

                                <Border x:Name="PreviewImageBorder"
                                        Height="{Binding PreviewImageHeight}"
                                        CornerRadius="15"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Border.Control}"
                                        Cursor="Hand"
                                        ToolTip="单击以置顶窗口打开图片"
                                        AutomationProperties.Name="以置顶窗口打开图片"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        MouseLeftButtonUp="PreviewImageBorder_MouseLeftButtonUp"
                                        Visibility="{Binding ImageContentVisibility}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PreviewImageSource}"
                                                    Stretch="Fill"
                                                    AlignmentX="Left"
                                                    AlignmentY="Top"/>
                                    </Border.Background>
                                </Border>

                            </Grid>



                        </local:CrispShadowBorder>
                </Popup>
                    
                </Grid>

            </Border>







        </Grid>


</Window>
