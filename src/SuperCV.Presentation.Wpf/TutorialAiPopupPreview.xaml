<UserControl x:Class="SuperCV.TutorialAiPopupPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SuperCV"
             Width="310"
             Height="260"
             IsHitTestVisible="False"
             Focusable="False">
    <!-- Mirrors CV.xaml's AIPopup without instantiating the separate AIChatbot window. -->
    <Grid Margin="15" Opacity="{Binding Opacity, Source={x:Static local:MainSurfaceAppearanceState.Current}, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:CrispShadowBorder Grid.Row="0"
                                 Width="280"
                                 Height="60"
                                 HorizontalAlignment="Left"
                                 Background="{DynamicResource Brush.Surface.Window}"
                                 CornerRadius="20">
            <local:CrispShadowBorder.ShadowEffect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="0"
                                  Color="{DynamicResource Color.Shadow.Surface}"
                                  Opacity="0.7"/>
            </local:CrispShadowBorder.ShadowEffect>
            <Border Margin="10"
                    CornerRadius="10"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Control}"
                    BorderThickness="1">
                <Grid>
                    <TextBlock Margin="10,0,38,0"
                               VerticalAlignment="Center"
                               Text="直接问AI"
                               FontSize="16"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Width="26"
                            Height="26"
                            Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="#5686fe"
                            BorderThickness="0"
                            Foreground="White">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="15" Height="15"><StaticResource ResourceKey="ArrowUp"/></Viewbox>
                    </Button>
                </Grid>
            </Border>
        </local:CrispShadowBorder>

        <local:CrispShadowBorder Grid.Row="1"
                                 Width="145"
                                 Margin="45,15,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Background="{DynamicResource Brush.Surface.Raised}"
                                 CornerRadius="10">
            <local:CrispShadowBorder.ShadowEffect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Color="{DynamicResource Color.Shadow.Surface}"
                                  Opacity="0.8"/>
            </local:CrispShadowBorder.ShadowEffect>
            <Grid Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Margin="2"
                        BorderThickness="0.5"
                        BorderBrush="{DynamicResource Brush.Border.Control}"
                        Style="{StaticResource moreButtonStyle1}"
                        HorizontalContentAlignment="Center"
                        Background="{DynamicResource Brush.Control.FillSubtle}"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.Text.Primary}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16"><StaticResource ResourceKey="Plus"/></Viewbox>
                        <Label Grid.Column="1" Content="添加新指令" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </Grid>
                </Button>
                <Border Grid.Row="1" Margin="2" Background="{DynamicResource Brush.Separator.Default}"/>
                <StackPanel Grid.Row="2" Margin="0,5,0,3">
                    <Grid Height="26"><Button Content="中英互译" Style="{StaticResource moreButtonStyle}" Padding="8,0" BorderThickness="0" HorizontalContentAlignment="Left" Height="26" Background="{DynamicResource Brush.Surface.Raised}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/><Button Width="20" Height="20" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource moreButtonDeleteStyle}" BorderThickness="0" Background="Transparent"><Viewbox Width="10" Height="10"><StaticResource ResourceKey="Close1"/></Viewbox></Button></Grid>
                    <Grid Height="26"><Button Content="智能摘要" Style="{StaticResource moreButtonStyle}" Padding="8,0" BorderThickness="0" HorizontalContentAlignment="Left" Height="26" Background="{DynamicResource Brush.Surface.Raised}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/><Button Width="20" Height="20" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource moreButtonDeleteStyle}" BorderThickness="0" Background="Transparent"><Viewbox Width="10" Height="10"><StaticResource ResourceKey="Close1"/></Viewbox></Button></Grid>
                    <Grid Height="26"><Button Content="文本润色" Style="{StaticResource moreButtonStyle}" Padding="8,0" BorderThickness="0" HorizontalContentAlignment="Left" Height="26" Background="{DynamicResource Brush.Surface.Raised}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/><Button Width="20" Height="20" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource moreButtonDeleteStyle}" BorderThickness="0" Background="Transparent"><Viewbox Width="10" Height="10"><StaticResource ResourceKey="Close1"/></Viewbox></Button></Grid>
                    <Grid Height="26"><Button Content="通俗解释" Style="{StaticResource moreButtonStyle}" Padding="8,0" BorderThickness="0" HorizontalContentAlignment="Left" Height="26" Background="{DynamicResource Brush.Surface.Raised}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"/><Button Width="20" Height="20" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource moreButtonDeleteStyle}" BorderThickness="0" Background="Transparent"><Viewbox Width="10" Height="10"><StaticResource ResourceKey="Close1"/></Viewbox></Button></Grid>
                </StackPanel>
            </Grid>
        </local:CrispShadowBorder>
    </Grid>
</UserControl>
