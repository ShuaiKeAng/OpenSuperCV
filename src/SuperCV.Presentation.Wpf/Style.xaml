                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb >
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="1.5" Background="{DynamicResource Brush.ScrollBar.ThumbSubtle}" >

                                            </Border>

                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CustomRadioButtonStyle"
           TargetType="RadioButton"
           BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                    <Border x:Name="border"
                            Background="{TemplateBinding  Background}"
                            CornerRadius="6">       
                        <ContentPresenter HorizontalAlignment="Center" 
                  VerticalAlignment="Center"
                  />

                    </Border>
                    
                        

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Window}" />
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" 
                                        ShadowDepth="0" 
                                        Color="{DynamicResource Color.Shadow.Surface}"
                                        Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                <DropShadowEffect BlurRadius="12" 
                        ShadowDepth="0" 
                        Color="{DynamicResource Color.Shadow.Surface}"
                        Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundSwitchStyle"
           TargetType="ToggleButton"
           BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" CornerRadius="12.5" Background="{DynamicResource Brush.Surface.Raised}" BorderThickness="1.5" BorderBrush="{DynamicResource Brush.Border.Raised}"/>
                        <ContentPresenter x:Name="IconPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Margin="4"
                                      Content="{TemplateBinding Content}" />

                    </Grid>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>

                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>

                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Muted}"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Control.Pressed}"/>

                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="roundButtonStyle2"
           TargetType="Button"
           BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="25"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Track Border 作为按钮背景和边框 -->
                        <Border x:Name="Track" 
                            CornerRadius="12.5" 
                            Background="{DynamicResource Brush.Surface.Raised}"
                            BorderThickness="1.5" 
                            BorderBrush="{DynamicResource Brush.Border.Raised}"/>

                        <!-- 内容呈现器 -->
                        <ContentPresenter x:Name="IconPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" 
                                      Margin="3"
                                      Content="{TemplateBinding Content}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 鼠标悬停状态（参考开关 IsChecked=False 时的悬停效果） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Muted}"/>
                        </Trigger>

                        <!-- 按下状态（参考开关的多触发器中使用的颜色） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Control.Pressed}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RoundedComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" 
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="{TemplateBinding Background}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      BorderBrush="{TemplateBinding BorderBrush}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Border" 
                                            CornerRadius="5" 
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 显示选中内容 -->
                                            <Border Grid.Column="0"
                                                    CornerRadius="5"
                                                    Margin="0"
                                                    Background="Transparent">
                                                <ContentPresenter Margin="8,3,0,3"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 下拉箭头 -->
                                            <Border Grid.Column="1"
                                                    CornerRadius="0,5,5,0"
                                                    Background="Transparent"
                                                    Width="30">
                                                <Path Data="M0,0 L8,0 L4,4 Z" 
                                                      Fill="{DynamicResource Brush.Icon.Subtle}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 触发器：鼠标悬停效果 -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#E8E8E8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- 下拉弹出框 -->
                        <Popup x:Name="Popup" 
                               Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder" 
                                    Background="{DynamicResource Brush.Surface.Raised}"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="0"
                                    CornerRadius="5"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer RenderOptions.ClearTypeHint="Enabled">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- 下拉项样式 -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem"
                       BasedOn="{StaticResource PointerOnlyControlStyle}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Border"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="8,5"
                                        Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#E8F0FE"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundedComboBoxStyle2"
           TargetType="ComboBox"
           BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" 
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
