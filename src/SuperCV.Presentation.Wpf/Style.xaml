<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SuperCV">


    <!-- Keep shadow effects off text-bearing visual subtrees. -->
    <Style TargetType="{x:Type local:CrispShadowBorder}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CrispShadowBorder}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Effect="{TemplateBinding ShadowEffect}"/>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RenderOptions.ClearTypeHint="Enabled"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PointerOnlyControlStyle" TargetType="{x:Type Control}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- Default all remaining non-text Control subclasses to pointer-only interaction.
         Text-entry controls opt back in immediately below. -->
    <Style TargetType="{x:Type Control}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
    </Style>
    <Style TargetType="{x:Type RichTextBox}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
    </Style>
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
    </Style>

    <Style TargetType="{x:Type Button}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>

    <Style TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>

    <!-- Non-text controls are operated with the pointer.  Keep their templates from
         receiving keyboard focus (and therefore the system's dotted focus adorner). -->
    <Style TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type ComboBoxItem}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type DataGrid}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type DataGridCell}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type DataGridRow}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type Expander}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type ListBox}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type ListBoxItem}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type ListView}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type ListViewItem}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type Slider}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type TabItem}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type TreeView}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>
    <Style TargetType="{x:Type TreeViewItem}"
           BasedOn="{StaticResource PointerOnlyControlStyle}"/>

    <!--
        The header logo is rendered by CrispWindowHeaderLogo as two layers:
        the shadow image keeps the existing projection, while the foreground
        image stays outside an Effect intermediate surface and remains sharp.
    -->
    <Style x:Key="WindowHeaderLogoImageStyle" TargetType="Image">
        <Setter Property="Source" Value="{DynamicResource WindowHeaderLogoSource}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="WindowHeaderLogoShadowImageStyle"
           TargetType="Image"
           BasedOn="{StaticResource WindowHeaderLogoImageStyle}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="0"
                                  Color="{DynamicResource Color.Shadow.Surface}"
                                  Opacity="0.5"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowHeaderTitleStyle" TargetType="Label">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="45,0,5,0"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="WindowHeaderCloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Icon.Primary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CloseButtonSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="0"
                                              Color="{DynamicResource Color.Shadow.Surface}"
                                              Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderOptions.ClearTypeHint="Enabled"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource Brush.Control.HoverSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CloseButtonSurface"
                                    Property="Background"
                                    Value="{DynamicResource Brush.Control.PressedSubtle}"/>
                            <Setter TargetName="CloseButtonSurface"
                                    Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="4"
                                                      ShadowDepth="0"
                                                      Color="{DynamicResource Color.Shadow.Surface}"
                                                      Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CloseButtonSurface"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Brush.Icon.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two-layer settings action: the outer surface remains raised while the inset
         surface provides the pointer feedback without changing the normal layout. -->
    <Style x:Key="SettingsInsetActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="InnerSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            RenderOptions.ClearTypeHint="Enabled"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InnerSurface"
                                    Property="Background"
                                    Value="{DynamicResource Brush.Control.HoverSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="InnerSurface"
                                    Property="Background"
                                    Value="{DynamicResource Brush.Control.PressedSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InnerSurface"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InnerSurface"
                                    Property="Background"
                                    Value="{DynamicResource Brush.Surface.Subtle}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="baseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PointerOnlyControlStyle}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                Background="{TemplateBinding Background}"
                CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderOptions.ClearTypeHint="Enabled"/>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" 
                  ShadowDepth="0" 
                  Color="{DynamicResource Color.Shadow.Surface}"
                                              RenderingBias="Performance"
                  Opacity="0.5"/>
                        </Border.Effect>
                    </Border>

                    <ControlTemplate.Triggers>
                        
                        <Trigger Property="IsMouseOver" Value="True">

                            
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" 
                                        ShadowDepth="0" 
                                        Color="{DynamicResource Color.Shadow.Surface}"
                                                      RenderingBias="Performance"
                                        Opacity="0.7"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">

                            
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="3" 
            ShadowDepth="0" 
            Color="{DynamicResource Color.Shadow.Surface}"
                                                      RenderingBias="Performance"
            Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="{DynamicResource Brush.Control.Hover}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>



    </Style>
    <Style x:Key="searchTextBoxStyle" TargetType="TextBox">
        <!-- 定义一些默认属性，使外观更统一 -->


        <Setter Property="BorderThickness" Value="1"/>


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <!-- 外层边框，用于定义圆角和阴影 -->
                    <local:CrispShadowBorder x:Name="border"
                        Background="{TemplateBinding Background}" 
                        CornerRadius="15"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <local:CrispShadowBorder.ShadowEffect>
                            <DropShadowEffect BlurRadius="5" 
                                      ShadowDepth="0" 
                                      Color="{DynamicResource Color.Shadow.Surface}"
                                      Opacity="0.5"/>
                        </local:CrispShadowBorder.ShadowEffect>

                        <ScrollViewer x:Name="PART_ContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Hidden"
                                  RenderOptions.ClearTypeHint="Enabled"/>
                    </local:CrispShadowBorder>
                    <!-- 可选的视觉状态触发器 -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Control.Highlight}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Control.Highlight}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="roundedRectangleButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PointerOnlyControlStyle}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <local:CrispShadowBorder x:Name="border"
                Background="{TemplateBinding Background}"
                CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderOptions.ClearTypeHint="Enabled"/>
                        <local:CrispShadowBorder.ShadowEffect>
                            <DropShadowEffect BlurRadius="0" 
                  ShadowDepth="0" 
                  Color="{DynamicResource Color.Shadow.Surface}"
                  Opacity="0.5"/>
                        </local:CrispShadowBorder.ShadowEffect>
                    </local:CrispShadowBorder>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">


                            <Setter TargetName="border" Property="ShadowEffect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" 
        ShadowDepth="0" 
        Color="{DynamicResource Color.Shadow.Surface}"
        Opacity="0.7"/>
                                </Setter.Value>

                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">


                            <Setter TargetName="border" Property="ShadowEffect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="2" 
                                    ShadowDepth="0" 
                                    Color="{DynamicResource Color.Shadow.Surface}"
                                    Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>



    </Style>
    <Style x:Key="moreButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PointerOnlyControlStyle}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>

                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Control.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border"
                                    Property="Background"
                                    Value="{DynamicResource Brush.Control.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>



    </Style>
