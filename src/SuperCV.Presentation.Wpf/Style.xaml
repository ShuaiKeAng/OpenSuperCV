    <Style x:Key="TutorialAgreementCheckBoxStyle"
       TargetType="CheckBox"
       BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="CheckBoxSurface"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                        <Grid>

                            <Border x:Name="CheckMarkSurface"
                                Width="20"
                                Height="20"
                                CornerRadius="5"
                                Background="{DynamicResource Brush.Surface.Raised}"
                                BorderBrush="{DynamicResource Brush.Border.Control}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                  Data="M3,9 L7,13 L15,4"
                                  Stroke="{DynamicResource Brush.Surface.Raised}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                            </Border>
                            
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBoxSurface" Property="Background" Value="{DynamicResource Brush.Control.HoverSubtle}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMarkSurface" Property="Background" Value="{DynamicResource Brush.Text.Primary}"/>
                            <Setter TargetName="CheckMarkSurface" Property="BorderBrush" Value="{DynamicResource Brush.Text.Primary}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="{DynamicResource Brush.Icon.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBoxSurface" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ShortcutCaptureButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PointerOnlyControlStyle}">
        <Setter Property="Width" Value="145"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Control.FillSubtle}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Soft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ShortcutBorder"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ShortcutBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Control.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ShortcutBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Control.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
