<Window x:Class="SuperCV.TextEntryBackgroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SuperCV"
        Title="文字条目背景"
        Width="399"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <local:CrispShadowBorder Margin="20"
                             CornerRadius="20"
                             Background="{DynamicResource Brush.Surface.Window}">
        <local:CrispShadowBorder.ShadowEffect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="0"
                              Color="{DynamicResource Color.Shadow.Surface}"
                              Opacity="0.5"/>
        </local:CrispShadowBorder.ShadowEffect>
        <Grid Margin="10" RenderOptions.ClearTypeHint="Enabled">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <local:CrispWindowHeaderLogo/>
                <Label Content="文字条目背景" Style="{StaticResource WindowHeaderTitleStyle}"/>
                <Button Style="{StaticResource WindowHeaderCloseButtonStyle}"
                        Click="Minimize_Click"
                        ToolTip="最小化"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="最小化文字条目背景设置"
                        Margin="4,4,45,4">
                    <Path Data="M0,5 L10,5"
                          Width="16"
                          Height="16"
                          Stroke="{DynamicResource Brush.Icon.Primary}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          Stretch="Fill"
                          IsHitTestVisible="False"/>
                </Button>
                <Button Style="{StaticResource WindowHeaderCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="4"
                        Click="CancelButton_Click"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭文字条目背景设置">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Width="16"
                          Height="16"
                          Stroke="{DynamicResource Brush.Icon.Primary}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Fill"
                          IsHitTestVisible="False"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="5,0,5,2">
                <StackPanel>
                    <TextBlock Text="选择图片后，在预览中拖动位置、使用滚轮缩放。图片会始终覆盖两个虚线框：左侧按钮显示时的区域，以及隐藏按钮后的完整区域。"
                               Margin="4,4,4,10"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               TextWrapping="Wrap"/>

                    <Border x:Name="PreviewFrame"
                            Height="174"
                            Margin="4,0"
                            Background="{DynamicResource Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Brush.Border.Soft}"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True"
                            SizeChanged="PreviewFrame_SizeChanged">
                        <Canvas x:Name="PreviewSurface"
                                Background="{DynamicResource Brush.Surface.Raised}"
                                MouseWheel="PreviewSurface_MouseWheel"
                                MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown"
                                MouseMove="PreviewSurface_MouseMove"
                                MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp">
                            <Canvas.Clip>
                                <RectangleGeometry x:Name="PreviewFrameClip"
                                                   RadiusX="9"
                                                   RadiusY="9"/>
                            </Canvas.Clip>
                        <Image x:Name="PreviewArtwork"
                               Source="{Binding PreviewImageSource}"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               IsHitTestVisible="False"/>

                        <Grid x:Name="PreviewViewport"
                              Width="268"
                              Height="98"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              ClipToBounds="False"
                              IsHitTestVisible="False">
                            <Rectangle Margin="1"
                                       RadiusX="14"
                                       RadiusY="14"
                                       Stroke="{DynamicResource Brush.Border.Focus}"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="3,3"
                                       ToolTip="隐藏侧边按钮后的完整文字区域"
                                       IsHitTestVisible="False"/>
                            <Grid Width="233"
                                  HorizontalAlignment="Right"
                                  IsHitTestVisible="False">
                                <Rectangle Margin="1"
                                           RadiusX="14"
                                           RadiusY="14"
                                           Stroke="{DynamicResource Brush.Border.Focus}"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="3,3"/>
                            </Grid>
                        </Grid>
                        </Canvas>
                    </Border>

                    <Grid Margin="4,12,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ImageFileName}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ImagePath}"/>
                        <Button Grid.Column="1"
                                Content="选择图片"
                                Style="{StaticResource ShortcutCaptureButtonStyle}"
                                Width="86"
                                Margin="8,0,0,0"
                                Click="ChooseImageButton_Click"
                                AutomationProperties.Name="选择背景图片"/>
                        <Button Grid.Column="2"
                                Content="移除"
                                Style="{StaticResource ShortcutCaptureButtonStyle}"
                                Width="72"
                                Margin="6,0,0,0"
                                Click="RemoveImageButton_Click"
                                AutomationProperties.Name="移除背景图片"/>
                    </Grid>

                    <Border Height="1" Margin="4,12" Background="{DynamicResource Brush.Separator.Default}"/>

                    <Grid Margin="4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="不透明度" FontSize="14" FontWeight="DemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text="{Binding OpacityPercentDisplay}" Grid.Column="1"
           VerticalAlignment="Center"
           HorizontalAlignment="Right"
           FontSize="12"
           FontWeight="DemiBold"
           Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <local:ContextLevelSlider Margin="0"
                                                      LevelCount="16"
                                                      Value="{Binding OpacityLevelIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="背景图片不透明度"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="应用"
                        Margin="0,5,5,0"
                        FontSize="18"
                        FontWeight="DemiBold"
                        Style="{StaticResource decideButtonStyle}"
                        Background="{DynamicResource Brush.Control.FillMuted}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Click="ApplyButton_Click"
                        AutomationProperties.Name="应用文字条目背景设置"/>
                <Button Grid.Column="1"
                        Content="取消"
                        Margin="5,5,0,0"
                        FontSize="18"
                        FontWeight="DemiBold"
                        Style="{StaticResource decideButtonStyle}"
                        Background="{DynamicResource Brush.Control.FillMuted}"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Click="CancelButton_Click"/>
            </Grid>
        </Grid>
    </local:CrispShadowBorder>
</Window>
