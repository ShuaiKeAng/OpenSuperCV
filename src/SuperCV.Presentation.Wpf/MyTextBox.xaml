<UserControl x:Class="SuperCV.MyTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SuperCV"
             mc:Ignorable="d">
    <Grid Width="160" Height="30">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Edit">
                    <Storyboard />
                </VisualState>
                <VisualState x:Name="Button">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="textBox"
                                         Storyboard.TargetProperty="Width"
                                         To="30" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="button"
                                         Storyboard.TargetProperty="Width"
                                         To="30" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="button"
                                         Storyboard.TargetProperty="Height"
                                         To="30" Duration="0:0:0.2"/>
                        <ThicknessAnimation Storyboard.TargetName="button" 
                                            Storyboard.TargetProperty="Margin"
                                           To="0,0,0,0" Duration="0:0:0.2"/>
                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="textBox" Storyboard.TargetProperty="IsEnabled">
                            <DiscreteBooleanKeyFrame KeyTime="0:0:0.2" Value="False"/>
                        </BooleanAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="ICON"
                                         Storyboard.TargetProperty="Width"
                                         To="15" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="ICON"
                                         Storyboard.TargetProperty="Height"
                                         To="15" Duration="0:0:0.2"/>

                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Back">
                    <Storyboard>
                        
                        <DoubleAnimation Storyboard.TargetName="textBox"
                                         Storyboard.TargetProperty="Width"
                                         To="160" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="button"
                                         Storyboard.TargetProperty="Width"
                                         To="20" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="button"
                                         Storyboard.TargetProperty="Height"
                                         To="20" Duration="0:0:0.2"/>
                        <ThicknessAnimation Storyboard.TargetName="button" 
                                            Storyboard.TargetProperty="Margin"
                                           To="5,5,5,5" Duration="0:0:0.2"/>
                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="textBox" Storyboard.TargetProperty="IsEnabled">
                            <DiscreteBooleanKeyFrame KeyTime="0:0:0.2" Value="True"/>
                        </BooleanAnimationUsingKeyFrames>
                        <DoubleAnimation Storyboard.TargetName="ICON"
                                         Storyboard.TargetProperty="Width"
                                         To="12" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="ICON"
                                         Storyboard.TargetProperty="Height"
                                         To="12" Duration="0:0:0.2"/>

                       
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBox x:Name="textBox" 
                 Height="30" 
                 Width="160"  
                 SelectionBrush="{DynamicResource Brush.Text.Selection}"
                 Foreground="{DynamicResource Brush.Text.Muted}"
                 Background="{DynamicResource Brush.Surface.Raised}"
                 BorderBrush="{DynamicResource Brush.Border.Control}"
                 Padding="3,2,20,2"
            FontSize="14" 
                 HorizontalAlignment="Right" 
                 TextChanged="textBox_TextChanged" GotFocus="textBox_GotFocus">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="border" 
                                        Background="{TemplateBinding Background}" 
                                        CornerRadius="15"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Grid>
                                        <StackPanel x:Name="CommandHintPanel"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Orientation="Horizontal"
                                                    local:LocalizationService.SkipLocalization="True"
                                                    IsHitTestVisible="False"
                                                    Visibility="Collapsed">
                                            <TextBlock x:Name="CommandHintPrefixPart"
                                                       FontFamily="{TemplateBinding FontFamily}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontStyle="{TemplateBinding FontStyle}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       FontStretch="{TemplateBinding FontStretch}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       Opacity="0.80"/>
                                            <TextBlock x:Name="CommandHintDescriptionPart"
                                                       FontFamily="{TemplateBinding FontFamily}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontStyle="{TemplateBinding FontStyle}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       FontStretch="{TemplateBinding FontStretch}"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       Opacity="0.50"/>
                                        </StackPanel>
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalScrollBarVisibility="Hidden"
                                                      HorizontalScrollBarVisibility="Hidden"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Control.Highlight}"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Raised}"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>

        <Path x:Name="EnterIcon"
      Data="F1 M14,22 L24,22 C24.8,22 25.5,21.3 25.5,20.5 L25.5,14.5 C25.5,14.2 25.7,14 26,14 C26.3,14 26.5,14.2 26.5,14.5 L26.5,20.5 C26.5,21.9 25.4,23 24,23 L14,23 L14,22 M17,26 C16.9,26 16.7,26 16.6,25.9 L13.6,22.9 C13.4,22.7 13.4,22.4 13.6,22.2 L16.6,19.2 C16.8,19 17.1,19 17.3,19.2 C17.5,19.4 17.5,19.7 17.3,19.9 L14.7,22.5 L17.3,25.1 C17.5,25.3 17.5,25.6 17.3,25.8 C17.2,25.9 17.1,26 17,26 Z"
      Fill="{DynamicResource Brush.Icon.Muted}"
      Width="12"
      Height="8"
      Stretch="Fill"
      VerticalAlignment="Center"
      HorizontalAlignment="Right"
      Margin="0,0,30,0"
      Visibility="Collapsed"
      IsHitTestVisible="False"
      RenderTransformOrigin="0.5,0.5"/>

        <!-- Combined from 021__arrow2_left.svg and 022__arrow2_right.svg in the supplied icon set. -->
        <Path x:Name="CommandHintDirectionIcon"
              Fill="{DynamicResource Brush.Icon.Muted}"
              Width="12"
              Height="12"
              Stretch="Uniform"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="0,0,30,0"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              Opacity="0.80"/>

        <Button x:Name="button" 
                Style="{StaticResource baseButtonStyle}" 
                Margin="5" 
                Height="20" 
                Width="20" 
                HorizontalAlignment="Right"  
                Background="{DynamicResource Brush.Surface.Raised}"
                Click="Button_Click">
            <Viewbox x:Name="ICON" Width="12" Height="12">
                <StaticResource ResourceKey="Right" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
