<Window x:Class="SuperCV.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SuperCV"
        Title="图片预览"
        Width="360"
        Height="260"
        MinWidth="160"
        MinHeight="120"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SourceInitialized="Window_SourceInitialized"
        LocationChanged="Window_LocationChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <local:CrispShadowBorder CornerRadius="20"
                                 Background="{DynamicResource Brush.Surface.Window}"
                                 Opacity="{Binding Opacity, Source={x:Static local:MainSurfaceAppearanceState.Current}, Mode=OneWay}">
            <local:CrispShadowBorder.ShadowEffect>
                <DropShadowEffect BlurRadius="30"
                                  ShadowDepth="0"
                                  Color="{DynamicResource Color.Shadow.Surface}"
                                  Opacity="0.5"/>
            </local:CrispShadowBorder.ShadowEffect>
            <Grid Margin="5">
                <Border CornerRadius="15"
                        Background="#FF171717"
                        BorderBrush="{DynamicResource Brush.Border.Control}"
                        BorderThickness="1">
                    <Grid>
                        <Rectangle RadiusX="15"
                                   RadiusY="15"
                                   Cursor="SizeAll"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   MouseLeftButtonDown="ImageSurface_MouseLeftButtonDown">
                            <Rectangle.Fill>
                                <ImageBrush x:Name="PreviewImageBrush"
                                            Stretch="Fill"
                                            AlignmentX="Left"
                                            AlignmentY="Top"/>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Button x:Name="CloseButton"
                                Width="24"
                                Height="24"
                                Margin="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.Overlay.Action}"
                                BorderThickness="0"
                                
                                Cursor="Hand"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="White"
                                ToolTip="关闭图片预览"
                                AutomationProperties.Name="关闭图片预览"
                                Click="CloseButton_Click">
                            <Button.Content>
                                <Viewbox Width="14"
         Height="14">

                                    <StaticResource ResourceKey="Close2"/>
                                </Viewbox>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseButtonSurface"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseButtonSurface"
                                                                Property="Background"
                                                                Value="{DynamicResource Brush.Overlay.ActionHover}"/>
                                                    </Trigger>
                                                   
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </local:CrispShadowBorder>
    </Grid>
</Window>
