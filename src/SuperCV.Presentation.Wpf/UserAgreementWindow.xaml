<Window x:Class="SuperCV.UserAgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SuperCV"
        Title="用户协议"
        Width="640"
        Height="700"
        MinWidth="620"
        MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <local:CrispShadowBorder CornerRadius="20"
                             Background="{DynamicResource Brush.Surface.Window}"
                             Margin="20">
        <local:CrispShadowBorder.ShadowEffect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="0"
                              Color="{DynamicResource Color.Shadow.Surface}"
                              Opacity="0.5" />
        </local:CrispShadowBorder.ShadowEffect>

        <Grid Margin="10" RenderOptions.ClearTypeHint="Enabled">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <local:CrispWindowHeaderLogo />
                <Label Content="{Binding WindowTitle}" Style="{StaticResource WindowHeaderTitleStyle}" />
                <Button Style="{StaticResource WindowHeaderCloseButtonStyle}"
                        Click="Minimize_Click"
                        ToolTip="最小化"
                        HorizontalAlignment="Right"
                        Margin="4,4,45,4"
                        AutomationProperties.Name="最小化用户协议">
                    <Path Data="M0,5 L10,5"
                          Width="16"
                          Height="16"
                          Stroke="{DynamicResource Brush.Icon.Primary}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Fill"
                          IsHitTestVisible="False" />
                </Button>
                <Button Style="{StaticResource WindowHeaderCloseButtonStyle}"
                        Click="Close_Click"
                        ToolTip="关闭"
                        HorizontalAlignment="Right"
                        Margin="4"
                        AutomationProperties.Name="关闭用户协议">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Width="16"
                          Height="16"
                          Stroke="{DynamicResource Brush.Icon.Primary}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Fill"
                          IsHitTestVisible="False" />
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Control}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,5,0,0"
                    Padding="2">
                <RichTextBox x:Name="AgreementDocument"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             IsDocumentEnabled="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="5,0,5,0"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             SelectionBrush="{DynamicResource Brush.Text.Selection}"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontSize="13"
                             AutomationProperties.Name="用户协议正文">
                    <RichTextBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar}" />
                    </RichTextBox.Resources>
                </RichTextBox>
            </Border>
        </Grid>
    </local:CrispShadowBorder>
</Window>
