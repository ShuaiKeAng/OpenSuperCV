<Window x:Class="SuperCV.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="SuperCV 托盘菜单"
        Width="224"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False"
        Opacity="0"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TrayStatusOnBrush" Color="#FF32B66A"/>
        <SolidColorBrush x:Key="TrayDangerBrush" Color="#FFE5484D"/>
        <SolidColorBrush x:Key="TrayDangerHoverBrush" Color="#18E5484D"/>

        <Style x:Key="TrayMenuButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              RenderOptions.ClearTypeHint="Enabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Control.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.Border.Default}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayExitButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource TrayMenuButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TrayDangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TrayDangerHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Keep the shadow in its own bitmap so menu text is never rasterized with it. -->
        <Border Background="{DynamicResource Brush.Surface.Raised}"
                BorderThickness="0"
                CornerRadius="15"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="0"
                                  Color="{DynamicResource Color.Shadow.Surface}"
                                  Opacity="0.5"/>
            </Border.Effect>
        </Border>

        <Border Padding="0"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderThickness="0"
                CornerRadius="15"
                SnapsToDevicePixels="True">
            <StackPanel Margin="0,3"
                        RenderOptions.ClearTypeHint="Enabled">
            

            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Click="OpenButton_Click"
                    automation:AutomationProperties.Name="打开 SuperCV">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="25"
                           Height="25"
                           Source="{DynamicResource WindowHeaderLogoSource}"
                           Stretch="Uniform">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="6"
                  ShadowDepth="0"
                  Color="{DynamicResource Color.Shadow.Surface}"
                  Opacity="0.5"/>
                        </Image.Effect>
                    </Image>
                    <StackPanel Grid.Column="1" Margin="0,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   FontWeight="DemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="打开 SuperCV"/>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Text="显示主窗口和剪贴板"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayMenuButtonStyle}"
                    Click="MonitoringButton_Click"
                    automation:AutomationProperties.Name="切换列表更新">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="21" Height="21">
                        <StaticResource ResourceKey="ListUpdateSwitchIcon"/>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MonitoringTitleText"
                                   FontSize="12"
                                   FontWeight="DemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <TextBlock x:Name="MonitoringDescriptionText"
                                   Margin="0,2,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Vertical"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="MonitoringStatusDot"
                                 Width="7"
                                 Height="7"
                                 Margin="0,0,5,1"/>
                        <TextBlock x:Name="MonitoringStatusText"
                                   FontSize="10" Margin="0,2,5,0"
                                   Foreground="{DynamicResource Brush.Text.Muted}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <Border Height="1"
                    Margin="5,3"
                    Background="{DynamicResource Brush.Separator.Default}"/>

            <Button Style="{StaticResource TrayExitButtonStyle}"
                    Click="ExitButton_Click"
                    automation:AutomationProperties.Name="退出 SuperCV">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="15" Height="15" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StaticResource ResourceKey="Close1"/>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Margin="0,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12"
                                   FontWeight="DemiBold"
                                   Foreground="{StaticResource TrayDangerBrush}"
                                   Text="退出"/>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Text="停止监听并关闭"/>
                    </StackPanel>
                </Grid>
            </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
