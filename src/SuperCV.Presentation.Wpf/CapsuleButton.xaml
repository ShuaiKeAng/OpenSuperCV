<UserControl x:Class="SuperCV.CapsuleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SuperCV"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             mc:Ignorable="d" 
             >
    <!-- Keep the shadow inside the control's layout bounds. This prevents the
         ScrollViewer/item containers from clipping its bitmap to a rectangle. -->
    <local:CrispShadowBorder x:Name="MainBorder"
                             Margin="4,0"
                             VerticalAlignment="Center"
                             CornerRadius="{Binding CornerRadius}"
                             Background="{Binding CapsuleBackground}"
                             SnapsToDevicePixels="True"
                             UseLayoutRounding="True"
                             MouseRightButtonDown="MainBorder_MouseRightButtonDown"
                             MouseRightButtonUp="MainBorder_MouseRightButtonUp">
        <local:CrispShadowBorder.Style>
            <Style TargetType="{x:Type local:CrispShadowBorder}"
                   BasedOn="{StaticResource {x:Type local:CrispShadowBorder}}">
                <Setter Property="ShadowEffect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="4"
                                          ShadowDepth="0"
                                          Color="{DynamicResource Color.Shadow.Surface}"
                                          Opacity="0.3"
                                          RenderingBias="Quality"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="ShadowEffect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="4"
                                                  ShadowDepth="0"
                                                  Color="{DynamicResource Color.Shadow.Surface}"
                                                  Opacity="0.6"
                                                  RenderingBias="Quality"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </local:CrispShadowBorder.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 文本部分 -->
            <TextBlock x:Name="TextContent" 
                       Grid.Column="0"
                       Text="{Binding Text}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="6,0,0,0"
                       MaxWidth="{Binding MaxWidth}"
                       TextTrimming="CharacterEllipsis"
                       MouseLeftButtonUp="TextContent_MouseLeftButtonUp" MouseLeftButtonDown="TextContent_MouseLeftButtonDown"/>

            <!-- 关闭按钮 -->
            <!-- 圆角关闭按钮 -->
            <Button x:Name="CloseButton"
                Grid.Column="1"

                Margin="{Binding ButtonMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Focusable="False"
                Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <!-- 默认外观 -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="back"
                                CornerRadius="{Binding CornerRadiusButton}"   
                                Background="Transparent"
                                   Width="{Binding ButtonHeight}"
                                            Height="{Binding ButtonHeight}">
                                        <Viewbox Stretch="Uniform" 
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
                                                 MaxWidth="8"  
                                            MaxHeight="8">
                                            <Path x:Name="icon"
              Data="M0,0 L10,10 M10,0 L0,10"
              Stroke="{DynamicResource Brush.Icon.Primary}"
              StrokeThickness="1"/>
                                        </Viewbox>
                                    </Border>

                                    <!-- 鼠标悬停、按下时的变化 -->
                                    <ControlTemplate.Triggers>
                                        <!-- MouseOver 时可以改背景、路径颜色、粗细、甚至放大 -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="back" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>

                                        </Trigger>
                                        <!-- 按下微缩，给个反馈 -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="back" Property="Background" Value="{DynamicResource Brush.Control.Pressed}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>




    </local:CrispShadowBorder>
</UserControl>
