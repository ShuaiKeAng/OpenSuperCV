<UserControl x:Class="SuperCV.CrispWindowHeaderLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40"
             Height="40"
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Grid SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <!--
            Keep the shadow layer separate from the sharp foreground image.
            WPF rasterizes an element with an Effect into an intermediate bitmap;
            putting the effect on a duplicate underneath prevents that bitmap
            from softening the visible logo.
        -->
        <Image Style="{StaticResource WindowHeaderLogoShadowImageStyle}"/>
        <Image Style="{StaticResource WindowHeaderLogoImageStyle}"
               Panel.ZIndex="1"/>
    </Grid>
</UserControl>
