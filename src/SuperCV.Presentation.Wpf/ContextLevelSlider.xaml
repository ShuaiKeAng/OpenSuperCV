<UserControl x:Class="SuperCV.ContextLevelSlider"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="24"
             MinWidth="120"
             Focusable="False"
             AutomationProperties.Name="上下文档位调节器">
    <!-- Keep the shell identical to WatermarkTextBoxStyle, which is used by API Key. -->
    <Border x:Name="TrackShell"
            Height="24"
            VerticalAlignment="Top"
            Background="{DynamicResource Brush.Control.FillSubtle}"
            BorderBrush="{DynamicResource Brush.Border.Soft}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Grid>
            <!-- TickBar reserves the same endpoint space as the thumb, keeping every level aligned. -->
            <TickBar Minimum="0"
                     Maximum="{Binding MaximumIndex, ElementName=Root}"
                     TickFrequency="1"
                     Placement="Top"
                     Height="4"
                     VerticalAlignment="Center"
                     ReservedSpace="24"
                     Fill="{DynamicResource Brush.Border.Muted}"
                     IsHitTestVisible="False" />

            <Slider x:Name="LevelSlider"
                    Minimum="0"
                    Maximum="{Binding MaximumIndex, ElementName=Root}"
                    Value="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TickFrequency="1"
                    SmallChange="1"
                    LargeChange="1"
                    IsSnapToTickEnabled="True"
                    IsMoveToPointEnabled="True"
                    Background="Transparent"
                    BorderThickness="0"
                    Height="16"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    FocusVisualStyle="{x:Null}"
                    AutomationProperties.Name="上下文档位"
                    AutomationProperties.HelpText="可使用左右方向键在各档位之间切换">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="LevelThumb"
                                           Width="14"
                                           Height="14"
                                           Cursor="Hand"
                                           DragStarted="LevelThumb_DragStarted"
                                           DragCompleted="LevelThumb_DragCompleted"
                                           Loaded="LevelThumb_Loaded"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        Width="14"
                                                        Height="14"
                                                        CornerRadius="7"
                                                        Background="{DynamicResource Brush.Surface.Raised}"
                                                        BorderBrush="{DynamicResource Brush.Border.Default}"
                                                        BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="2"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.18"
                                                                          Color="#000000" />
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface"
                                                                Property="Background"
                                                                Value="{DynamicResource Brush.Control.Hover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface"
                                                                Property="Background"
                                                                Value="{DynamicResource Brush.Control.Pressed}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>
        </Grid>
    </Border>
</UserControl>
